---
import { Font } from "astro:assets";
import Navbar from "../components/Navbar/Navbar.astro";
import Footer from "../components/Footer/Footer.astro";
import '@/styles/global.scss'
import '@/styles/components.scss'
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
}

const title = Astro.props.title
const description = Astro.props.description
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-barlow" />
    <!-- TODO: all this stuff so its SEO optimised and shit -->
    <!-- TODO: look into yoast SEO they are good - content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <ClientRouter />
  </head>
  <body>
    <Navbar />
    <main role="main" id="content"><slot /></main>
    <Footer />
  </body>
</html>
