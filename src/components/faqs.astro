---
import Phone from '@assets/svgs/phone.svg'
import ArrowButton from '@assets/svgs/arrow-button.svg'
import Chevron from '@assets/svgs/chevron.svg'
import Reveal from './reveal.astro';

type question = {
    question: string;
    answer: string
}

const questions: question[] = [
    {
        question: 'Can you handle one-offs and prototypes, or just production runs?',
        answer: 'Both. A huge part of our work is one-off and small-batch — bespoke cabinets, machine guards, brackets, prototypes. The same shop also handles repeat production for OEM customers, so quantities can scale without changing supplier.'
    },
        {
        question: 'Do I need finished drawings to get a quote',
        answer: 'Both. A huge part of our work is one-off and small-batch — bespoke cabinets, machine guards, brackets, prototypes. The same shop also handles repeat production for OEM customers, so quantities can scale without changing supplier.'
    }
]
// TODO: all of these properly
// TODO: make all of this come through as an object so it can be used in services and then services-cncpunching

interface Props {
  darkerBg: boolean
}

const {darkerBg} = Astro.props
---

<div class={darkerBg ? 'darkerBg' : ''}>
  <div class="mainBlock mainBlockGrid">
    <div class="mainBlockText">
      <p class="blueTitle">Services FAQs</p>
      <div class="textBlock">
        <h2 class="h2Title h2TitleFullWidth">Sheet metal questions - answered.</h2>
        <h3 class="h2TitleFullWidth">The questions we hear most across our services. Materials, lead times, tolerances, deliveries — straight answers, no jargon.</h3>
      </div>
      <div class="stillQuestion">
        <div class="stillTop">
          <p>Still have a question?</p>
          <span>Speak to our team directly — drawings, sketches or just an idea.</span>
        </div>
        <div class="buttonRow">
          <a href="tel:+441782749000" class="darkBlueButton whitePath">
            <Phone />
            <p>01782 749000</p>
          </a>
          <a href="/contact-us" class="hollowButton darkPath">
            <p>Get a Quote</p>
            <ArrowButton />
          </a>
        </div>
      </div>
    </div>
    <div class="questions">
      {
        questions.map((quest, i) => (
          <Reveal from="right" delay={i * 70}>
            <details class="questionItem" name="faq">
              <summary>
                <div class="questionRow">
                  <div class="numberHouse">
                    <span>{i + 1}</span>
                  </div>
                  <p>{quest.question}</p>
                </div>
                <Chevron />
              </summary>
              <div class="questionAnswer">
                <p>{quest.answer}</p>
              </div>
            </details>
          </Reveal>
        ))
      }
    </div>
  </div>
</div>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .questions {
    margin: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .questionItem {
    width: 100%;
    height: fit-content;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 16px;
    padding: 20px;
    padding-bottom: 10px;

    cursor: pointer;
    list-style: none;
    transition: 0.3s;
    display: flex;
    flex-direction: column;
    gap: 12px;

    &[open] {
      border-color: rgba(2, 132, 199, 0.3);
      box-shadow:
        0px 6px 12px -6px rgba(15, 23, 42, 0.08),
        0px 12px 30px -10px rgba(2, 132, 199, 0.25);
      padding-bottom: 20px;

      svg {
        rotate: 180deg;
      }
    }

    .questionRow {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 16px;
    }

    summary {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;

      p {
        font-family: var(--font-barlow);
        font-weight: 700;
        font-size: 16px;
        color: #0f172a;
      }

      svg {
        transition: 0.3s;
        min-width: 11px;
        min-height: 11px;
      }

      &::-webkit-details-marker {
        display: none;
      }
      &::marker {
        content: '';
      }
    }

    .numberHouse {
      width: 32px;
      height: 32px;
      background: rgba(2, 132, 199, 0.1);
      border-radius: 8px;
      flex-shrink: 0;

      display: flex;
      justify-content: center;
      align-items: center;

      span {
        font-family: var(--font-barlow);
        font-weight: 700;
        font-size: 14px;
        color: #0393cf;
      }
    }

    .questionAnswer {
      margin-left: 47px;
      border-left: 2px solid rgba(3, 149, 210, 0.2);

      p {
        font-weight: 400;
        font-size: 14px;
        color: #4b5563;
        margin-left: 12px;
      }
    }
  }

  .hollowButton {
    p {
      color: #0f172a !important;
      white-space: nowrap;
      font-weight: 600;
      font-size: 14px;
    }

    border: 0.8px solid #e5e9f0 !important;
  }

  .buttonRow {
    gap: 12px;
    flex-direction: column;

    @include bp(tiny) {
      flex-direction: row;
    }
  }

  .stillQuestion {
    width: 100%;
    height: fit-content;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;

    .stillTop {
      display: flex;
      flex-direction: column;
      gap: 6px;

      p {
        font-weight: 600;
        font-size: 14px;
        color: #0f172a;
      }

      span {
        font-weight: 400;
        font-size: 14px;
        color: #4b5563;
      }
    }
  }
</style>
