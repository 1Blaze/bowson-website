---
import Reveal from '../reveal.astro';
import Merit from '@assets/svgs/merit.svg';
import Factory from '@assets/svgs/factory.svg';
import Sheild from '@assets/svgs/shield.svg';
import GreySvgBox from '../grey-svg-box.astro';

type ServiceType = {
  title: string;
  description: string;
  svg: typeof Merit;
};

// TEXT THIS
const services: ServiceType[] = [
  {
    title: 'ISO 9001',
    description: 'Documented quality, traceability and material certs available.',
    svg: Sheild

  },
  {
    title: 'Full Workflow',
    description: 'CNC punch, laser, press brake, welding, powder coating in-house.',
    svg: Factory

  },
  {
    title: 'Repeat Customers',
    description: 'From OEMs to one-off commissions — built on relationships.',
    svg: Merit

  },
];
---

<!-- TEXT: SORT THIS -->
<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="left" class="selfCenter">
        <GreySvgBox {...service} />
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .servicesDisplay {
    @include bp(lg) {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      margin-top: 25px;
      gap: 50px;
    }
  }

  .selfCenter {
    align-self: center;
  }
</style>
