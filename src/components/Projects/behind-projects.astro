---
import Reveal from '../reveal.astro';
import Merit from '@assets/svgs/merit.svg';
import Factory from '@assets/svgs/factory.svg';
import Sheild from '@assets/svgs/shield.svg';
import GreySvgBox from '../grey-svg-box.astro';

type ServiceType = {
  title: string;
  description: string;
  svg: typeof Merit;
};

const services: ServiceType[] = [
  {
    title: 'Family-owned since 1990',
    description: 'Three generations of making sheet metal products in Stoke-on-Trent.',
    svg: Sheild,
  },
  {
    title: 'In-house workflow',
    description: 'CNC punching, press brake bending, rolling, welding and powder coating all under one roof, with laser-cut blanks through our cutting partner.',
    svg: Factory,
  },
  {
    title: 'Repeat customers',
    description: 'Manufacturers and businesses come back to us for the same parts again and again, from one-offs to regular batches.',
    svg: Merit,
  }
];
---

<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="left" class="selfCenter">
        <GreySvgBox {...service} />
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .servicesDisplay {
    @include bp(lg) {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      margin-top: 25px;
      gap: 50px;
    }
  }

  .selfCenter {
    align-self: center;
  }
</style>
