---
import { GetAllProjects, GetTagsWithCounts } from '../../data/projects';
import SectorItem from '../sector-item.astro';
import Reveal from '../reveal.astro';
import Search from '@assets/svgs/search.svg'
const Tags = GetTagsWithCounts()

const projects = GetAllProjects();
const lengthOfProjects = projects.length
---

<div class="mainBlock">
  <div class="projectRow">
    <div class="mainBlockText">
      <p class="blueTitle">Gallery</p>
      <div class="textBlock">
        <h2 class="h2Title h2TitleFullWidth">Browse our completed work.</h2>
        <h3 class="h2TitleFullWidth">Filter by sector or finish, search for a keyword, then click any project to see it full-size.</h3>
      </div>
    </div>
    <div class="projectInput">
      <Search />
      <input type="text" id="projectSearch" placeholder="Search projects, sectors..." />
    </div>
  </div>

  <div class="tagList">
    <button class="tagButton tagButtonAll active" data-tag="all">
      <p>All</p>
      <div class="tagCircle">
        <span>{lengthOfProjects}</span>
      </div>
    </button>
    {
      Tags.map((tag) => (
        <button class="tagButton" data-tag={tag.tag}>
          <p>{tag.tag}</p>
          <div class="tagCircle">
            <span>{tag.count}</span>
          </div>
        </button>
      ))
    }
  </div>
  <div>Showing <span id="projectCount">{lengthOfProjects}</span> of {lengthOfProjects} projects</div>
  <div class="sectorsDisplay projectsDisplay">
    {
      projects.map(({ slug, data }, index) => (
        <Reveal class={data.selected ? 'projectItemFeatured project-card' : 'project-card'} delay={index * 70} data-title={data.title.toLowerCase()} data-summary={data.description.toLowerCase()} data-tag={data.tag}>
          <SectorItem orangeText={data.tag} title={data.title} description={data.description} cta="View Project" href={'projects/' + slug} selected={data.selected} />
        </Reveal>
      ))
    }
  </div>
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  :global(.docs-reveal.project-card) {
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
    transition-delay: 0s;
  }

  :global(.docs-reveal.project-card.is-filtered-out) {
    opacity: 0;
    transform: scale(0.96);
    pointer-events: none;
  }

  .projectRow {
    display: flex;
    flex-direction: column;
    gap: 20px;

    @include bp(lg) {
      display: grid !important;
      grid-template-columns: 3fr 1fr;
      align-items: flex-end;
    }
  }

  .projectInput {
    width: 100%;
    height: 40.2px;
    background: #ffffff;
    border: 0.8px solid #cecece;
    border-radius: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 0 15px;

    input {
      width: 100%;
      height: 100%;
      border: none;
      background: none;
      font-weight: 400;
      font-size: 14px;
      color: #080341;

      &::placeholder {
        color: #757575;
      }

      &:focus {
        outline: none;
      }
    }
  }

  .tagList {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    width: 100%;

    .tagButtonAll {
      background-color: #0f172a !important;
      border-color: #0f172a !important;
      color: #fff !important;

      .tagCircle {
        background-color: #555151 !important;

        span {
          color: #fff !important;
        }
      }
    }

    .tagButton {
      width: fit-content;
      height: 39.5px;
      background: #ffffff;
      border: 0.8px solid #e5e9f0;
      border-radius: 999px;
      flex-shrink: 0;
      font-weight: 600;
      font-size: 14.6px;
      text-align: center;
      color: #0f172a;
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 0 15px;
      gap: 8px;
      cursor: pointer;
      transition: 0.3s;
    }

    .active {
      background: #ffffff;
      border: 0.8px solid #0393cf;
      color: #0292cf;
    }

    .tagCircle {
      width: 20px;
      height: 20px;
      background: #eeeeee;
      opacity: 0.6;
      border-radius: 50%;
      transition: 0.3s;

      span {
        font-weight: 700;
        font-size: 11px;
        text-align: center;
        transition: 0.3s;
        color: #0f172a;
      }
    }
  }
</style>

<script>
  const searchInput = document.getElementById('projectSearch') as HTMLInputElement;
  const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tagButton');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const countEl = document.getElementById('projectCount');

  let activeTag = 'all';

  function setCardVisibility(card: HTMLElement, visible: boolean): void {
    if (visible) {
      // Un-hide before animating back in, then force a reflow so the
      // browser registers "display: block" before we remove the class —
      // otherwise the opacity transition gets skipped entirely.
      card.style.display = '';
      void card.offsetWidth;
      card.classList.remove('is-filtered-out');
    } else {
      card.classList.add('is-filtered-out');
    }
  }

  function applyFilters(): void {
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const title = card.dataset.title ?? '';
      const summary = card.dataset.summary ?? '';
      const tag = card.dataset.tag ?? '';

      const matchesSearch = query === '' || title.includes(query) || summary.includes(query);
      const matchesTag = activeTag === 'all' || tag === activeTag;
      const isVisible = matchesSearch && matchesTag;

      setCardVisibility(card, isVisible);
      if (isVisible) visibleCount++;
    });

    if (countEl) countEl.textContent = String(visibleCount);
  }

  function debounce<T extends (...args: never[]) => void>(fn: T, wait: number) {
    let timeout: ReturnType<typeof setTimeout>;
    return (...args: Parameters<T>) => {
      clearTimeout(timeout);
      timeout = setTimeout(() => fn(...args), wait);
    };
  }

  // Only fully remove a card from layout once its fade-out has actually
  // finished — if we set display:none immediately, opacity/transform
  // never get a chance to animate.
  cards.forEach((card) => {
    card.addEventListener('transitionend', (e) => {
      if (e.propertyName !== 'opacity') return;
      if (card.classList.contains('is-filtered-out')) {
        card.style.display = 'none';
      }
    });
  });

  // Debounced so a fast typist doesn't re-trigger the fade on every
  // keystroke — clicks on tag pills stay instant since they're a single
  // discrete action, not a stream of events.
  searchInput.addEventListener('input', debounce(applyFilters, 150));

  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeTag = btn.dataset.tag ?? 'all';
      tagButtons.forEach((b) => b.classList.toggle('active', b === btn));
      applyFilters();
    });
  });

  applyFilters();
</script>
