---
import '../Reused.scss';
import { Image } from 'astro:assets';
import Punch from '@assets/images/Projects/home.webp'
import Phone from '@assets/svgs/phone.svg'
import ArrowButton from '@assets/svgs/arrow-button.svg'
import Grid from './grid.astro';
import type { QuestionAskedType } from '../faqs.astro';
import Faqs from '../faqs.astro';
import CallToAction from '../call-to-action.astro';
import ProjectsSearch from './projects-search.astro';
import BehindProjects from './behind-projects.astro';

const questionData: QuestionAskedType = {
  title: 'Commissioning bespoke work.',
  description: 'Most people who reach out have either seen something in our gallery, or have a problem an off-the-shelf product won\'t solve. Here\'s what they usually ask first.',
  questions: [
    {
      question: 'Can you make something like one of the projects here?',
      answer: 'Usually, yes. Tell us which project is closest and what you need to change, such as size, material, finish or quantity, and we will confirm what is possible and quote within 24 hours.',
    },
    {
      question: 'Can you build something that is not in the gallery?',
      answer: 'Yes. The gallery is a selection of recent work, not a catalogue. Send a drawing, a sketch, a sample or just an idea, and we will tell you whether we can make it.',
    },
    {
      question: 'Do you keep drawings so I can re-order the same product?',
      answer: 'Yes. Once a product has been made, we keep the design, so repeat orders can be quoted and made without starting from scratch.',
    },
    {
      question: 'Can you change the size or finish of a product I have seen?',
      answer: 'Yes. Most of our products are made to order, so we can adjust dimensions, shelves, doors and fixings, and powder coat in the colour you need.',
    },
    {
      question: 'What happens after I send an enquiry?',
      answer: 'We confirm the materials, quantities and finish with you, then send a quote within 24 hours. Once you approve it, we make and finish the product in our own workshop and arrange delivery or collection.',
    },
  ],
}
---

<section class="sectionHome">
  <div class="sectionTop">
    <div class="imgBg">
      <Image src={Punch} alt="A Section of metal items ready to be weldeded and powder coated after being formed on the press brake" />
      <div class="imgOverlay"></div>
    </div>
    <div class="sectionImgOver">
      <div class="sectionTopFlex">
        <p class="orangeColour">Projects & Gallery</p>
        <h1>Bespoke sheet metal, built to last.</h1>
      </div>
      <p class="sectionTopDesc">A selection of recent work from our Stoke-on-Trent workshop, including deer towers, kiln frames, work benches, pallet gates and machine guarding. Browse by sector to find something close to what you need.</p>
      <div class="sectionTopButtons">
        <a href="/contact-us" class="orangeButton whitePath">
          <p>Discuss your project</p>
          <ArrowButton />
        </a>
        <a class="hollowButton whitePath" href="tel:+441782749000">
          <Phone />
          <p>01782 749000</p>
        </a>
      </div>
    </div>
  </div>
  <Grid borderAndBg={true} />
  <ProjectsSearch />
  <div class="darkerBg">
    <div class="mainBlock mainBlockGrid">
      <div class="mainBlockText">
        <p class="blueTitle">Behind every project</p>
        <div class="textBlock">
          <h2 class="h2Title h2TitleFullWidth">Design, fabricate, finish - one workshop.</h2>
          <h3 class="h2TitleFullWidth">Every piece in this gallery was drawn, profiled, bent, welded and finished in our Stoke-on-Trent workshop. Keeping it all under one roof is how we hit tight deadlines and stay honest about quality.</h3>
        </div>
        <div class="sectionTopButtons">
          <a href="/services" class="blueButton whitePath">
            <p>Explore Services</p>
            <ArrowButton />
          </a>
          <a class="hollowButton whitePath darkerTextButton" href="/sectors">
            <p>View Sectors</p>
          </a>
        </div>
      </div>
      <BehindProjects />
    </div>
  </div>
  <Faqs darkerBg={false} questionData={questionData} />
  <CallToAction />
</section>

<style lang="scss">
  .sectionTopButtons {
    display: flex;
    flex-direction: row;
    gap: 16px;
  }

  .darkerTextButton {
    p {
      color: #0f172a !important;
      white-space: nowrap;
      font-weight: 600;
      font-size: 14px;
    }

    border: 0.8px solid #e5e9f0 !important;
  }
</style>
