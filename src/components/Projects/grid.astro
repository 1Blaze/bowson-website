---
import Stacked from '@assets/svgs/stacked.svg'
import Factory from '@assets/svgs/factory.svg'
import Shield from '@assets/svgs/shield.svg'
import Location from '@assets/svgs/location.svg'
import Reveal from '../reveal.astro'

interface Props {
  borderAndBg: boolean
}

const borderAndBg = Astro.props.borderAndBg
---

<Reveal>
  <div class={borderAndBg ? 'infoGridWrapperBorderBg' : 'infoGridWrapper'}>
    <div class="infoGrid">
      <div class="gridItem">
        <div class="icon"><Stacked /></div>
        <div><p>24+</p><span>Projects in gallery</span></div>
      </div>
      <div class="gridItem">
        <div class="icon"><Shield /></div>
        <div><p>35+ years</p><span>Of bespoke work</span></div>
      </div>
      <div class="gridItem">
        <div class="icon"><Factory /></div>
        <div><p>One roof</p><span>Design {'->'} finish</span></div>
        <!-- TEXT: SORT THIS -->
      </div>
      <div class="gridItem">
        <div class="icon"><Location /></div>
        <div><p>UK-wide</p><span>Delivered nationally</span></div>
      </div>
    </div>
  </div>
</Reveal>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .infoGrid {
    padding: 0;

    @include bp(lg) {
      padding: 0 100px;
    }
  }
</style>
