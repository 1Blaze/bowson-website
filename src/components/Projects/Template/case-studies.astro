---
import { GetAllProjects } from "~/src/data/projects";
import Reveal from "../../reveal.astro";
import { Image } from "astro:assets";
import Arrow from '@assets/svgs/arrow-button.svg'

const projects = GetAllProjects()
---

<div class="servicesDisplay">
  {
    projects.slice(0, 3).map(({ slug, data }, i) => (
      <Reveal delay={i * 70} from="left">
        <a href={slug} class="caseStudy">
          <Image src={data.image} alt={data.title} />
          <div class="caseStudyCol">
            <p>NO. 01 — Logistics & Storage</p>
            <h3>Mezzanine Pallet Gate</h3>
            <div class="readRow orangePath">
              <span>Read</span>
              <Arrow />
            </div>
          </div>
        </a>
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../../styles/breakpoints' as *;

  .caseStudy {
    text-decoration: none;
    width: 100%;
    height: 358.5px;
    transition: 0.3s;
    cursor: pointer;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;

    img {
      height: 262px;
      width: 100%;
      border-radius: 12px;
    }

    .caseStudyCol {
      display: flex;
      flex-direction: column;
      gap: 12px;

      p {
        font-weight: 400;
        font-size: 9.4px;
        letter-spacing: 2px;
        color: #62748e;
        text-transform: uppercase;
      }

      h3 {
        font-family: var(--font-barlow);
        font-weight: 700;
        font-size: 17px;
        color: #0f172a;
      }

      span {
        font-weight: 400;
        font-size: 12px;
        color: #ea580c;
      }
    }

    .readRow {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 6px;
      text-decoration: none;
    }

    &:hover {
      transform: translateY(-5px);
      scale: 1.02;
    }
  }
</style>
