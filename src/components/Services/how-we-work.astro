---
import Reveal from '../reveal.astro';
import Clipboard from '@assets/svgs/clipboard.svg';
import Stars from '@assets/svgs/stars.svg';
import Cog from '@assets/svgs/cog.svg';
import Delivery from '@assets/svgs/delivery.svg';

type ServiceType = {
  title: string;
  description: string;
  svg: typeof Clipboard;
};

const services: ServiceType[] = [
  {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    svg: Clipboard

  },
  {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    svg: Stars

  },
  {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    svg: Cog

  },
  {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    svg: Delivery
  },
];
// TODO: Proper text
---

<div class="servicesDisplay">
  {
    services.map((service, i) => {
      const Icon = service.svg;
      return (
        <Reveal delay={i * 70} from="left">
          <div class="howWeWork">
            <div class="svgHouse">
              <Icon />
            </div>
            <div class="textGap">
              <p>{i + 1}. Enquiry</p>
              <span>Send a drawing, sketch or sample. We confirm materials, quantities and finish, and quote within one working day.</span>
            </div>
          </div>
        </Reveal>
      );
    })
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .servicesDisplay {
    @include bp(lg) {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      margin-top: 25px;
      gap: 50px;
    }
  }

  .howWeWork {
    width: 100%;
    height: fit-content;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 22px;

    .svgHouse {
      width: 44px;
      height: 44px;
      background: rgba(2, 132, 199, 0.1);
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .textGap {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    p {
      font-family: var(--font-barlow);
      font-weight: 700;
      font-size: 18px;
      color: #0f172a;
    }

    span {
      font-weight: 400;
      font-size: 14px;
      color: #4b5563;
    }
  }
</style>
