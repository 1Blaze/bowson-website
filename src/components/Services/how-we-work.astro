---
import Reveal from '../reveal.astro';
import Clipboard from '@assets/svgs/clipboard.svg';
import Stars from '@assets/svgs/stars.svg';
import Cog from '@assets/svgs/cog.svg';
import Delivery from '@assets/svgs/delivery.svg';
import GreySvgBox from '../grey-svg-box.astro';

type ServiceType = {
  title: string;
  description: string;
  svg: typeof Clipboard;
};

const services: ServiceType[] = [
  {
    title: 'Enquiry',
    description: 'Send a drawing, sketch or sample. We confirm materials, quantities and finish, and quote within 24 hours.',
    svg: Clipboard,
  },
  {
    title: 'Design & Review',
    description: 'Where needed, we produce SolidWorks drawings and review the design to find the most cost-effective way to make it.',
    svg: Stars,
  },
  {
    title: 'Manufacture',
    description: 'CNC punching, press brake bending, rolling and welding in our own workshop.',
    svg: Cog,
  },
  {
    title: 'Finish & deliver',
    description: 'In-house powder coating, weld cleaning where needed, then delivery or collection as a finished part.',
    svg: Delivery,
  },
];
---

<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="left">
        <GreySvgBox {...service} title={`${i + 1}. ${service.title}`} />
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .servicesDisplay {
    @include bp(lg) {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      margin-top: 25px;
      gap: 50px;
    }
  }
</style>
