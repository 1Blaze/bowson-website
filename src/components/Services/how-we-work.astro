---
import Reveal from '../reveal.astro';


type ServiceType = {
  title: string;
  description: string;
//   TODO: add the SVG stuff
};

const services: ServiceType[] = [
  {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',

  },
    {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',

  },
    {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',

  },
    {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
  },
];
---

<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="left">
        <div class="howWeWork">
          <div class="svgHouse">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.5 1.6665H7.49999C7.03975 1.6665 6.66666 2.0396 6.66666 2.49984V4.1665C6.66666 4.62674 7.03975 4.99984 7.49999 4.99984H12.5C12.9602 4.99984 13.3333 4.62674 13.3333 4.1665V2.49984C13.3333 2.0396 12.9602 1.6665 12.5 1.6665Z" stroke="#0393CF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path
                d="M13.3333 3.3335H15C15.442 3.3335 15.866 3.50909 16.1785 3.82165C16.4911 4.13421 16.6667 4.55814 16.6667 5.00016V16.6668C16.6667 17.1089 16.4911 17.5328 16.1785 17.8453C15.866 18.1579 15.442 18.3335 15 18.3335H5.00001C4.55798 18.3335 4.13406 18.1579 3.8215 17.8453C3.50894 17.5328 3.33334 17.1089 3.33334 16.6668V5.00016C3.33334 4.55814 3.50894 4.13421 3.8215 3.82165C4.13406 3.50909 4.55798 3.3335 5.00001 3.3335H6.66668"
                stroke="#0393CF"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path d="M10 9.1665H13.3333" stroke="#0393CF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M10 13.3335H13.3333" stroke="#0393CF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M6.66666 9.1665H6.67416" stroke="#0393CF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M6.66666 13.3335H6.67416" stroke="#0393CF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {/* TODO: all these svgs in asset folders and do the text for each stuff */}
          </div>
          <div class="textGap">
            <p>{i + 1}. Enquiry</p>
            <span>Send a drawing, sketch or sample. We confirm materials, quantities and finish, and quote within one working day.</span>
          </div>
        </div>
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .servicesDisplay {
    @include bp(lg) {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      margin-top: 25px;
      gap: 50px;
    }
  }

  .howWeWork {
    width: 100%;
    height: fit-content;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 22px;

    .svgHouse {
      width: 44px;
      height: 44px;
      background: rgba(2, 132, 199, 0.1);
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .textGap {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    p {
      font-family: var(--font-barlow);
      font-weight: 700;
      font-size: 18px;
      color: #0f172a;
    }

    span {
      font-weight: 400;
      font-size: 14px;
      color: #4b5563;
    }
  }
</style>
