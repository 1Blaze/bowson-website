---
import { GetService } from "~/src/data/services";
import { Image } from 'astro:assets';
import Punch from '@assets/images/Punch_TODO_Change.webp'
import Phone from '@assets/svgs/phone.svg'
import Arrow from '@assets/svgs/arrow-button.svg'
import ListCircle from '@assets/svgs/list-circle.svg'
import '../../Reused.scss';
import CallToAction from "../../call-to-action.astro";
import Faqs from "../../faqs.astro";
import Reveal from "../../reveal.astro";

interface Props {
  id: string
}

const id = Astro.props.id

const data = GetService(id)
---

<section class="sectionHome">
  <div class="sectionTop">
    <div class="imgBg">
      <Image src={data.image} alt={data.imageAlt} />
      <div class="imgOverlay"></div>
    </div>
    <div class="sectionImgOver">
      <div class="sectionTopFlex">
        <span>Services</span>
        <h1>{data.title}</h1>
      </div>
      <p class="sectionTopDesc">{data.description}</p>
      <div class="sectionTopButtons">
        <button class="orangeButton whitePath" type="submit">
          <p>Request a Quote</p>
          <Arrow />
        </button>
        <a class="hollowButton whitePath" href="tel:+441782749000">
          <Phone />
          <p>01782 749000</p>
        </a>
      </div>
    </div>
  </div>
  <div class="mainBlock servicesGrid">
    <div class="mainBlockText">
      <p class="blueTitle">Overview</p>
      <div class="textBlock">
        <h2 class="h2Title">What we offer.</h2>
        <h3 class="h2TitleFullWidth">{data.whatWeOffer.para1}</h3>
        <h3 class="h2TitleFullWidth">{data.whatWeOffer.para2}</h3>
        <h3 class="h2TitleFullWidth">{data.whatWeOffer.para3}</h3>
      </div>
    </div>
    <div class="capabilities">
      <p>Capabilities & Specs</p>
      <ul>
        {
          data.whatWeOffer.capabilities.map((item) => (
            <li>
              <div class="capabilityCircle">
                <ListCircle />
              </div>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="darkerBg">
    <div class="mainBlock">
      <div class="mainBlockText">
        <p class="blueTitle">Equipment & Process</p>
        <div class="textBlock">
          <h2 class="h2Title">The kit behind the work</h2>
        </div>
      </div>
      <div class="servicesDisplay service2Col">
        {
          data.theKit.map((item, i) => (
            <Reveal from="up" delay={i * 70}>
              <div class="serviceItem">
                <Image src={item.image} alt={item.title} />
                <div class="serviceTextGap">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </div>
  <div class="mainBlock">
    <div class="mainBlockText">
      <p class="blueTitle">Typical applications</p>
      <div class="textBlock">
        <h2 class="h2Title">Where it's used</h2>
      </div>
    </div>
    <div class="whereItsUsed">
      {
        data.whereItsUsed.map((item, i) => (
          <Reveal from="left" delay={i * 70}>
            <div class="item">
              <p>{item}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
    <!-- TODO: make the link work -->
    <a href="/" class="serviceLearnMore serviceLearnMoreHover">
      <span>See bespoke projects</span>
      <Arrow />
    </a>
  </div>
  <Faqs darkerBg={true} questionData={data.questionsAsked} />
  <div class="mainBlock mainBlockGrid">
    <div class="mainBlockText">
      <p class="blueTitle">Related services</p>
      <div class="textBlock">
        <h2 class="h2Title h2TitleFullWidth">You might also need.</h2>
      </div>
    </div>
    <div class="servicesDisplay">
      {
        data.mightAlsoNeed.map((service, i) => (
          <Reveal delay={i * 70} from="down">
            <a href={`/services/${service.href}`} class="serviceItem">
              <Image src={service.image} alt={service.title} />
              <div class="serviceTextGap">
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <div class="serviceLearnMore">
                  <span>Learn more</span>
                  <Arrow />
                </div>
              </div>
            </a>
          </Reveal>
        ))
      }
    </div>
  </div>
  <CallToAction />
</section>

<style lang="scss">
  @use '../../../styles/breakpoints' as *;

  .sectionTop {
    --heroHeight: 470px !important;
  }

  .servicesGrid {
    @include bp(lg) {
      display: grid !important;
      grid-template-columns: 1fr 0.6fr;
      align-items: center;
    }
  }

  .whereItsUsed {
    display: flex;
    flex-direction: column;
    gap: 10px;

    @include bp(lg) {
      flex-direction: row;
    }

    .item {
      width: fit-content;
      height: 38.6px;
      background: #f8fafc;
      border: 1px solid #e5e9f0;
      border-radius: 999px;
      padding: 0 16px;
      display: flex;
      align-items: center;

      p {
        font-weight: 500;
        font-size: 14px;
        color: #0f172a;
      }
    }
  }
</style>
