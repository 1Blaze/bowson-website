---
type question = {
    question: string;
    answer: string
}

const questions: question[] = [
    {
        question: 'Can you handle one-offs and prototypes, or just production runs?',
        answer: 'Both. A huge part of our work is one-off and small-batch — bespoke cabinets, machine guards, brackets, prototypes. The same shop also handles repeat production for OEM customers, so quantities can scale without changing supplier.'
    },
        {
        question: 'Do I need finished drawings to get a quote',
        answer: 'Both. A huge part of our work is one-off and small-batch — bespoke cabinets, machine guards, brackets, prototypes. The same shop also handles repeat production for OEM customers, so quantities can scale without changing supplier.'
    }
]
// TODO: all of these properly
---

<div class="questions">
  {
    questions.map((quest, i) => (
      <details class="questionItem" name="faq">
        <summary>
          <div class="questionRow">
            <div class="numberHouse">
              <span>{i + 1}</span>
            </div>
            <p>{quest.question}</p>
          </div>
          <svg width="11" height="6" viewBox="0 0 11 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.75 0.75L5.25 5.25L9.75 0.75" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {/* TODO: Add to asset */}
        </summary>
        <div class="questionAnswer">
          <p>{quest.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .questions {
    margin: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .questionItem {
    width: 100%;
    height: fit-content;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 16px;
    padding: 20px;
    padding-bottom: 10px;

    cursor: pointer;
    list-style: none;
    transition: 0.3s;
    display: flex;
    flex-direction: column;
    gap: 12px;

    &[open] {
      border-color: rgba(2, 132, 199, 0.3);
      box-shadow:
        0px 6px 12px -6px rgba(15, 23, 42, 0.08),
        0px 12px 30px -10px rgba(2, 132, 199, 0.25);
      padding-bottom: 20px;

      svg {
        rotate: 180deg;
      }
    }

    .questionRow {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 16px;
    }

    summary {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;

      p {
        font-family: var(--font-barlow);
        font-weight: 700;
        font-size: 16px;
        color: #0f172a;
      }

      svg {
        transition: 0.3s;
        min-width: 11px;
        min-height: 11px;
      }

      &::-webkit-details-marker {
        display: none;
      }
      &::marker {
        content: '';
      }
    }

    .numberHouse {
      width: 32px;
      height: 32px;
      background: rgba(2, 132, 199, 0.1);
      border-radius: 8px;
      flex-shrink: 0;

      display: flex;
      justify-content: center;
      align-items: center;

      span {
        font-family: var(--font-barlow);
        font-weight: 700;
        font-size: 14px;
        color: #0393cf;
      }
    }

    .questionAnswer {
      margin-left: 47px;
      border-left: 2px solid rgba(3, 149, 210, 0.2);

      p {
        font-weight: 400;
        font-size: 14px;
        color: #4b5563;
        margin-left: 12px;
      }
    }
  }
</style>
