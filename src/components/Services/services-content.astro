---
import InfoGrid from '../info-grid.astro';
import '../Reused.scss';
import Phone from '@assets/svgs/phone.svg'
import Reveal from '../reveal.astro';
import ServiceGrid from '../service-grid.astro';
import HowWeWork from './how-we-work.astro';
import WhyBowson from './why-bowson.astro';
import CallToAction from '../call-to-action.astro';
import Faqs from '../faqs.astro';
---

<section class="sectionHome">
  <div class="sectionTop">
    <div class="imgBg">
      <!-- TODO: change to astro image -->
      <img src="https://www.bowson.co.uk/images/speasyimagegallery/albums/1/images/img-8270.jpg" alt="" />
      <div class="imgOverlay"></div>
    </div>
    <div class="sectionImgOver">
      <div class="sectionTopFlex">
        <span>Services</span>
        <h1>In-house engineering from design to finished product.</h1>
      </div>
      <p class="sectionTopDesc">CNC punching, laser cutting, press brake bending, MIG/TIG welding, powder coating and SolidWorks design — all under one roof in Stoke-on-Trent. One PO, one supplier, finished parts.</p>
      <div class="sectionTopButtons">
        <button class="orangeButton" type="submit">
          <p>Request a Quote</p>
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.666687 5.33337H10" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M5.33337 0.666687L10 5.33335L5.33337 10" stroke="white" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <!-- TODO: make work and change to assets -->
        </button>
        <div class="hollowButton whitePath">
          <Phone />
          <a href="tel:+441782749000">01782 749000</a>
          <!-- TODO: make this clickable for on phone and the button an A not just the number -->
        </div>
      </div>
    </div>
  </div>
  <InfoGrid borderAndBg={true} />
  <div class="mainBlock">
    <div class="mainBlockText">
      <p class="blueTitle">What we do</p>
      <div class="textBlock">
        <h2 class="h2Title">Six in-house services, one supplier.</h2>
        <h3>Pick a service to see equipment, capacities and typical applications — or get in touch and we'll match the right combination to your project.</h3>
      </div>
    </div>
    <ServiceGrid />
  </div>
  <div class="darkerBg">
    <div class="mainBlock">
      <div class="mainBlockText">
        <p class="blueTitle">How we work</p>
        <div class="textBlock">
          <h2 class="h2Title">From enquiry to finished product.</h2>
        </div>
      </div>
      <HowWeWork />
    </div>
  </div>
  <div class="mainBlock mainBlockGrid">
    <div class="mainBlockText">
      <p class="blueTitle">Why Bowson</p>
      <div class="textBlock">
        <h2 class="h2Title h2TitleFullWidth">A family-run shop that takes ownership of the whole job.</h2>
        <h3 class="h2TitleFullWidth">We've been making bespoke sheet metal products in Stoke-on-Trent since 1990. Because every step happens under one roof, you get a single point of contact, faster turnaround and parts that arrive finished.</h3>
      </div>
    </div>
    <WhyBowson />
  </div>
  <div class="darkerBg">
    <div class="mainBlock">
      <div class="mainBlockText">
        <p class="blueTitle">Materials & Capacity</p>
        <div class="textBlock">
          <h2 class="h2Title">At-a-glance capacities.</h2>
          <h3 class="h2TitleFullWidth">Our day-to-day envelope. If your part sits outside these limits we'll usually still have a route — just ask.</h3>
        </div>
      </div>
      <div class="capacityTables">
        <Reveal from="left" class="tableBigger">
          <table class="capacityTable">
            <tr class="top">
              <th>Material</th>
              <th>Punch</th>
              <th>Laser</th>
              <th>Bend</th>
            </tr>
            <tr>
              <td class="bold">Mild Steel</td>
              <td>3mm</td>
              <td>30mm</td>
              <td>6mm</td>
            </tr>
            <tr>
              <td class="bold">Stainless Steel</td>
              <td>2mm</td>
              <td>30mm</td>
              <td>5mm</td>
            </tr>
            <tr>
              <td class="bold">Aluminium</td>
              <td>4mm</td>
              <td>30mm</td>
              <td>6mm</td>
            </tr>
          </table>
        </Reveal>
        <Reveal from="right" delay="100" class="tableSmaller">
          <table class="capacityTable smallerTable">
            <tr class="top">
              <th>Name</th>
              <th>Working Aera</th>
            </tr>
            <tr>
              <td class="bold">CNC Punch</td>
              <td>3000 x 1250</td>
            </tr>
            <tr>
              <td class="bold">Laser Cutting</td>
              <td>4000 x 2000</td>
            </tr>
            <tr>
              <td class="bold">Press Brake</td>
              <td>3000 x 130 Ton</td>
            </tr>
            <tr>
              <td class="bold">Powder Coating</td>
              <td>3.3w x 2.4h x 4l</td>
            </tr>
          </table>
        </Reveal>
      </div>
    </div>
  </div>
  <Faqs darkerBg={false} />
  <CallToAction />
</section>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .capacityTables {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 25px;

    @include bp(lg) {
      flex-direction: row;
      // align-items: center;
      align-items: stretch;
    }
  }

  .capacityTable {
    // background: #0f172a;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    border-collapse: collapse;
    width: 100%;
    height: 301px;
  }

  .top {
    background: #0f172a;
  }

  th {
    font-weight: 600;
    color: #ffffff;
    padding: 0 8px;
    // height: 75px;
    width: 25%;
  }

  td {
    font-weight: 400;
    font-size: 14px;
    color: #4b5563;
    //   width: 25%;
    padding: 0 8px;
    // height: 75px;
    text-align: center;
  }

  tr {
    border-top: 0.8px solid #e5e9f0;
  }

  .bold {
    font-weight: 600;
    font-size: 14px;
    color: #0f172a;
  }
</style>
