---
import InfoGrid from '../info-grid.astro';
import '../Reused.scss';
import { Image } from 'astro:assets';
import Punch from '@assets/images/services/punch.webp'
import Phone from '@assets/svgs/phone.svg'
import ArrowButton from '@assets/svgs/arrow-button.svg'
import Reveal from '../reveal.astro';
import ServiceGrid from '../service-grid.astro';
import HowWeWork from './how-we-work.astro';
import WhyBowson from './why-bowson.astro';
import CallToAction from '../call-to-action.astro';
import Faqs, { type QuestionAskedType } from '../faqs.astro';

const questionData: QuestionAskedType = {
  title: 'Sheet metal questions - answered',
  description: 'The questions we hear most across our services. Materials, lead times, tolerances, deliveries — straight answers, no jargon.',
  questions: [
    {
      question: 'Can you handle one-offs and prototypes, or just production runs?',
      answer: 'Both. A large part of our work is one-off and small-batch: cabinets, machine guards, brackets and prototypes. We also run repeat production, so quantities can grow without changing supplier.',    },
    {
      question: 'Do I need finished drawings to get a quote',
      answer: 'No. We can work from technical drawings, sketches, existing samples or an initial idea. If you need help developing your design, our SolidWorks 3D CAD design service can produce models and technical drawings, while helping identify cost-effective ways to manufacture your product.',    },
    {
      question: 'What is sheet metal fabrication, and what can be made with it?',
      answer: 'Sheet metal fabrication turns flat sheet into finished products through a number of different processes including punching, bending, rolling, welding and finishing, the goal being to create the required parts, assemblies and items meeting specific purposes and tolerances. Producing a wide range of parts such as cabinets and enclosures, machine guards, work benches, stillages, pallet gates, kiln hoods and deer towers from steel, stainless steel and aluminium',
    },
    {
      question: 'What file formats can you accept?',
      answer: 'We can work with a range of common engineering file formats, including DXF, DWG, STEP, 3D CAD files and PDF drawings. If you only have a sketch, sample or physical part, get in touch and we can discuss the best way to develop it into a manufacturable design.',
    },
    {
      question: 'How quickly can you turn work around?',
      answer: 'We aim to provide quotations within 24 hours of receiving your enquiry. Typical production lead times are around 2–4 weeks, depending on the complexity, quantity and requirements of the job. If you have a specific deadline, let us know and we will confirm what is achievable.',
    },
    {
      question: 'What materials do you work with?',
      answer: 'Mild steel, stainless steel and aluminium sheet. See the capacity table above for the thicknesses we can punch, cut, bend and roll, and tell us if your part falls outside it.',
    },
    {
      question: 'Can you powder coat parts you have not made?',
      answer: 'Yes. Our in-house powder coating facility is available for both our own manufactured products and components supplied by customers. With our own coating booth and curing oven, we offer a range of stock powder colours to provide a durable, professional finish.',
    },
    {
      question: 'What manufacturing tolerances can you work to?',
      answer: 'Achievable tolerances depend on the material, thickness, manufacturing process and geometry of the component. We consider these requirements during the design and quotation stage to ensure parts are manufactured to suit their intended application. If you have specific tolerances or drawing requirements, include them with your enquiry.',
    },
  ]
}
---

<section class="sectionHome">
  <div class="sectionTop">
    <div class="imgBg">
      <Image src={Punch} alt="Turret punch tooling punching a pattern of rectangular holes in a steel sheet" />
      <div class="imgOverlay"></div>
    </div>
    <div class="sectionImgOver">
      <div class="sectionTopFlex">
        <p class="orangeColour">Services</p>
        <h1>Sheet metal fabrication from design to finished product.</h1>
      </div>
      <p class="sectionTopDesc">CNC punching, laser cutting, press brake bending, MIG/TIG welding, powder coating and SolidWorks design — all under one roof in Stoke-on-Trent. One PO, one supplier, finished parts.</p>
      <div class="sectionTopButtons">
        <a href="/contact-us" class="orangeButton whitePath">
          <p>Request a Quote</p>
          <ArrowButton />
        </a>
        <a class="hollowButton whitePath" href="tel:+441782749000">
          <Phone />
          <p>01782 749000</p>
        </a>
      </div>
    </div>
  </div>
  <InfoGrid borderAndBg={true} />
  <div class="mainBlock">
    <div class="mainBlockText">
      <p class="blueTitle">What we do</p>
      <div class="textBlock">
        <h2 class="h2Title">Six services, one supplier.</h2>
        <h3>Pick a service to see equipment, capacities and typical applications, or get in touch and we'll match the right combination to your project.</h3>
      </div>
    </div>
    <ServiceGrid />
  </div>
  <div class="darkerBg">
    <div class="mainBlock">
      <div class="mainBlockText">
        <p class="blueTitle">How we work</p>
        <div class="textBlock">
          <h2 class="h2Title">From enquiry to finished product.</h2>
        </div>
      </div>
      <HowWeWork />
    </div>
  </div>
  <div class="mainBlock mainBlockGrid">
    <div class="mainBlockText">
      <p class="blueTitle">Why Bowson</p>
      <div class="textBlock">
        <h2 class="h2Title h2TitleFullWidth">A family-run shop that takes ownership of the whole job.</h2>
        <h3 class="h2TitleFullWidth">We've been making bespoke sheet metal products in Stoke-on-Trent since 1990. Because every step happens under one roof, you get a single point of contact, faster turnaround and parts that arrive finished.</h3>
      </div>
    </div>
    <WhyBowson />
  </div>
  <div class="darkerBg">
    <div class="mainBlock">
      <div class="mainBlockText">
        <p class="blueTitle">Materials & Capacity</p>
        <div class="textBlock">
          <h2 class="h2Title">At-a-glance capacities.</h2>
          <h3 class="h2TitleFullWidth">Our day-to-day envelope. If your part sits outside these limits we'll usually still have a route — just ask.</h3>
        </div>
      </div>
      <div class="capacityTables">
        <Reveal from="left" class="tableBigger">
          <table class="capacityTable">
            <tr class="top">
              <th>Material</th>
              <th>Punch</th>
              <th>Laser</th>
              <th>Bend</th>
            </tr>
            <tr>
              <td class="bold">Mild Steel</td>
              <td>3mm</td>
              <td>30mm</td>
              <td>6mm</td>
            </tr>
            <tr>
              <td class="bold">Stainless Steel</td>
              <td>2mm</td>
              <td>30mm</td>
              <td>5mm</td>
            </tr>
            <tr>
              <td class="bold">Aluminium</td>
              <td>4mm</td>
              <td>30mm</td>
              <td>6mm</td>
            </tr>
          </table>
        </Reveal>
        <Reveal from="right" delay={100} class="tableSmaller">
          <table class="capacityTable smallerTable">
            <tr class="top">
              <th>Name</th>
              <th>Working Aera</th>
            </tr>
            <tr>
              <td class="bold">CNC Punch</td>
              <td>3000 x 1250 mm</td>
            </tr>
            <tr>
              <td class="bold">Laser Cutting</td>
              <td>4000 x 2000 mm</td>
            </tr>
            <tr>
              <td class="bold">Press Brake</td>
              <td>3000 mm x 150 Ton</td>
            </tr>
            <tr>
              <td class="bold">Powder Coating</td>
              <td>3.3W x 2.4H x 4L M</td>
            </tr>
          </table>
        </Reveal>
      </div>
    </div>
  </div>
  <Faqs darkerBg={false} questionData={questionData} />
  <CallToAction />
</section>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .capacityTables {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 25px;

    @include bp(lg) {
      flex-direction: row;
      // align-items: center;
      align-items: stretch;
    }
  }

  .capacityTable {
    // background: #0f172a;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    border-collapse: collapse;
    width: 100%;
    height: 301px;
  }

  .top {
    background: #0f172a;
  }

  th {
    font-weight: 600;
    color: #ffffff;
    padding: 0 8px;
    // height: 75px;
    width: 25%;
  }

  td {
    font-weight: 400;
    font-size: 14px;
    color: #4b5563;
    //   width: 25%;
    padding: 0 8px;
    // height: 75px;
    text-align: center;
  }

  tr {
    border-top: 0.8px solid #e5e9f0;
  }

  .bold {
    font-weight: 600;
    font-size: 14px;
    color: #0f172a;
  }
</style>
