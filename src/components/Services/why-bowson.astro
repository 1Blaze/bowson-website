---
import Reveal from '../reveal.astro';


type ServiceType = {
  title: string;
  description: string;
//   TODO: add the SVG stuff
};

const services: ServiceType[] = [
  {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',

  },
    {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',

  },
    {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',

  },
];
---

<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="right">
        <div class="howWeWork">
          <div class="svgHouse">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 18.3332C10 18.3332 16.6667 14.9998 16.6667 9.99984V4.1665L10 1.6665L3.33334 4.1665V9.99984C3.33334 14.9998 10 18.3332 10 18.3332Z" stroke="#0393CF" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
            </svg>

            {/* TODO: all these svgs in asset folders and do the text for each stuff */}
          </div>
          <div class="textGap">
            <p>Quality & Reliability</p>
            <span>Consistent, accurate work delivered on time — one-off or batch.</span>
          </div>
        </div>
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .servicesDisplay {
    @include bp(lg) {
      align-items: center;
    }
  }

  .howWeWork {
    width: 100%;
    height: fit-content;
    background: #f8fafc;
    border: 0.8px solid #d0d0d0;
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 22px;

    .svgHouse {
      width: 44px;
      height: 44px;
      background: rgba(2, 132, 199, 0.1);
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .textGap {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    p {
      font-family: var(--font-barlow);
      font-weight: 700;
      font-size: 18px;
      color: #0f172a;
    }

    span {
      font-weight: 400;
      font-size: 14px;
      color: #4b5563;
    }
  }
</style>
