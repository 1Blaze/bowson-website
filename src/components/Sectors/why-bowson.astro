---
import Reveal from '../reveal.astro';
import Stars from '@assets/svgs/stars.svg';
import Clock from '@assets/svgs/clock.svg';
import Sheild from '@assets/svgs/shield.svg';
import GreySvgBox from '../grey-svg-box.astro';

type ServiceType = {
  title: string;
  description: string;
  svg: typeof Stars;
};

const services: ServiceType[] = [
  {
    title: 'Bespoke by default',
    description: 'Send a drawing, sketch or sample. We confirm materials, quantities and finish, and quote within 24 hours.',
    svg: Stars,
  },
  {
    title: 'Quoted fast, made in-house',
    description: 'Punching, bending, rolling, welding and powder coating all happen in our own workshop, so your job keeps moving even when it is a one-off.',
    svg: Clock,
  },
  {
    title: 'Built to last',
    description: 'The right material and finish for where it will be used, from stainless steel to galvanised outdoor steel.',
    svg: Sheild, 
  },
];
---

<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="left">
        <GreySvgBox {...service} />
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .servicesDisplay {
    @include bp(lg) {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      margin-top: 25px;
      gap: 50px;
    }
  }
</style>
