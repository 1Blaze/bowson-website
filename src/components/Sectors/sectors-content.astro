---
import '../Reused.scss';
import { Image } from 'astro:assets';
import Punch from '@assets/images/Sectors/ceramics.webp'
import Phone from '@assets/svgs/phone.svg'
import ArrowButton from '@assets/svgs/arrow-button.svg'
import InfoGrid from '../info-grid.astro';
import type { QuestionAskedType } from '../faqs.astro';
import Faqs from '../faqs.astro';
import CallToAction from '../call-to-action.astro';
import SectorItem from '../sector-item.astro';
import Reveal from '../reveal.astro';
import WhyBowson from './why-bowson.astro';
import { SectorItems } from '../sector-grid.astro';

const questionData: QuestionAskedType = {
  title: 'Cross-sector questions.',
  description: 'From food-safe stainless to galvanised outdoor steel, here\'s what teams across industries ask us most.',
  questions: [
    {
      question: 'Which sectors do you work with, and do you take other work?',
      answer: 'Most of our work is in six sectors: manufacturing and production, material handling and storage, safety and access, agriculture and estates, ceramics and kilns, and vehicle and campervan conversions. We are a general fabrication shop, so if your job sits outside them, send us a drawing, sketch or idea and we will tell you whether we can make it.',
    },
    {
      question: 'Do you supply directly, or only through resellers?',
      answer: 'We supply directly. You deal with us from enquiry to delivery, with no middleman.',
    },
    {
      question: 'Do you make standard products, or only bespoke?',
      answer: 'Mostly bespoke. Products such as stillages, work benches and cabinets are made to your size and specification, and repeat designs can be re-ordered without starting again.',
    },
    {
      question: 'What about outdoor and agricultural products?',
      answer: 'We make deer towers in galvanised steel, dog kennel structures and shelters for outdoor use. Tell us where it will be used, and we will recommend a suitable finish, such as galvanising or powder coating.',
    },
    {
      question: 'Can you finish products in our company colours?',
      answer: 'Yes. We powder coat in our own oven with a wide range of stock colours. Tell us the colour you need and we will confirm what we can match.',
    },
    {
      question: 'Can you visit site to take measurements?',
      answer: 'Yes. We can visit your site to measure up, which is especially useful for platforms, guarding, shelters and other fitted items. Where a visit is not practical, send photos and dimensions or a sketch and we can work from those.',
    },
    {
      question: 'Do you have experience with food-safe or hygiene-critical work?',
      answer: 'Occasionally. We have made tables, surfaces and enclosures for hygiene-critical environments, but it is not the bulk of our work. If you need smooth, cleanable stainless fabrication, tell us the grade, finish and standard you need, and we will confirm what we can do before we quote.',
    },
  ]
}

---

<section class="sectionHome">
  <div class="sectionTop">
    <div class="imgBg">
      <Image src={Punch} alt="Blue powder coated steel kiln frame with a hood section on top" />
      <div class="imgOverlay"></div>
    </div>
    <div class="sectionImgOver">
      <div class="sectionTopFlex">
        <p class="orangeColour">Sectors</p>
        <h1>Sheet metal fabrication for six sectors.</h1>
      </div>
      <p class="sectionTopDesc">From production lines and warehouses to woodland estates, potteries and campervan builders, we make bespoke steel and sheet metal products built for real working environments.</p>
      <div class="sectionTopButtons">
        <a href="/contact-us" class="orangeButton whitePath">
          <p>Request a Quote</p>
          <ArrowButton />
        </a>
        <a class="hollowButton whitePath" href="tel:+441782749000">
          <Phone />
          <p>01782 749000</p>
        </a>
      </div>
    </div>
  </div>
  <InfoGrid borderAndBg={true} />
  <div class="mainBlock">
    <div class="mainBlockText">
      <p class="blueTitle">Industries we serve</p>
      <div class="textBlock">
        <h2 class="h2Title">Pick a sector to see how we work in it.</h2>
        <h3>Each sector has its own demands, from materials and finishes to safety detailing and delivery. Choose the one closest to your job and see what we make for it.</h3>
      </div>
    </div>
    <div class="sectorsDisplay">
      {
        SectorItems.map((item, i) => (
          <Reveal delay={i * 70} class={item.selected ? 'sectorItemFeatured' : ''}>
            <SectorItem {...item} />
          </Reveal>
        ))
      }
    </div>
  </div>
  <div class="darkerBg">
    <div class="mainBlock">
      <div class="mainBlockText">
        <p class="blueTitle">Why Bowson</p>
        <div class="textBlock">
          <h2 class="h2Title">The same workshop, tuned to every sector.</h2>
          <h3>Whatever the industry, we start from your drawing or idea, design the part for manufacture, make and finish it in our own workshop, and deliver it ready to use. That's why so much of our work is repeat business.</h3>
        </div>
      </div>
      <WhyBowson />
    </div>
  </div>
  <Faqs darkerBg={false} questionData={questionData} />
  <CallToAction />
</section>

