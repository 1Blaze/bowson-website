---
import Lightning from '@assets/svgs/lightning.svg';
import Reveal from '../reveal.astro';

type ServiceType = {
  title: string;
  description: string;
  svg: typeof Lightning;
};

const services: ServiceType[] = [
  {
    title: '50+ years',
    description: 'British Engineering',
    svg: Lightning
  },
  {
    title: '50+ years',
    description: 'British Engineering',
    svg: Lightning
  },
  {
    title: '50+ years',
    description: 'British Engineering',
    svg: Lightning
  },
  {
    title: '50+ years',
    description: 'British Engineering',
    svg: Lightning
  },
];
---

<div class="contactGrid">
  {
    services.map((service, i) => {
      const Icon = service.svg;
      return (
        <Reveal delay={i * 70} from="left">
          <div class="contactGridItem">
            <Icon />
            <p>{service.title}</p>
            <span>{service.description}</span>
          </div>
        </Reveal>
      );
    })
  }
</div>
<!-- TEXT: SORT THIS -->

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .contactGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;

    .contactGridItem {
      width: 100%;
      height: 110.4px;
      background: rgba(255, 255, 255, 0.05);
      border: 0.8px solid rgba(255, 255, 255, 0.18);
      border-radius: 12px;
      padding: 20px;

      p {
        font-family: var(--font-barlow);
        font-weight: 700;
        font-size: 16.8px;
        color: #ffffff;
      }

      span {
        font-weight: 400;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.7);
      }
    }
  }
</style>
