---
import '../Reused.scss';
import Phone from '@assets/svgs/phone.svg'
import Mail from '@assets/svgs/mail.svg'
import Message from '@assets/svgs/message.svg'
import Arrow from '@assets/svgs/arrow-button.svg'
import ContactInfo from './contact-info.astro'
import WhiteForms from './white-forms.astro'
import Faqs, { type QuestionAskedType } from '../faqs.astro';
import HeadingInfo from './heading-info.astro';

const questionData: QuestionAskedType = {
  title: 'Before you get in touch',
  description: 'A few answers to the things customers most often ask before sending an enquiry.',
  questions: [
    {
      question: 'What should I include in my enquiry?',
      answer: 'A drawing, sketch, sample or photo, plus the material if you know it, the quantity you need, the finish you want and your deadline. If you are missing any of these, send what you have and we will fill in the gaps with you.',
    },
    {
      question: 'How quickly will I hear back?',
      answer: 'We quote within 24 hours of receiving your enquiry. If it is urgent, call us on 01782 749000 and tell us your deadline.',
    },
    {
      question: 'Can I visit the workshop, or can you come to me?',
      answer: 'We can visit your site to measure up, and you are welcome to visit our workshop in Fenton. Call or email first so we can arrange a time.',
    },
    {
      question: 'Will you keep my drawings and designs confidential?',
      answer: 'Yes. We treat customer drawings and designs as confidential, and we are happy to sign an NDA if you need one.',
    },
  ]
}
---

<section class="sectionHome">
  <div class="sectionTop">
    <div class="gradientBg"></div>
    <div class="sectionImgOver sectionImgOverCol">
      <div class="sectionLeftContact">
        <div class="sectionTopFlex">
          <div class="contactBubble">
            <Message />
            <p>Contact</p>
          </div>
          <h1>Let's talk about your <span class="underline">next project</span></h1>
        </div>
        <p class="sectionTopDesc">Whether you need a one-off prototype or a repeat production run, our team in Fenton, Stoke-on-Trent is ready to help. Call, email, visit by appointment, or send us a brief below, and we will quote within 24 hours.</p>
        <div class="sectionTopButtons">
          <a href="/contact-us" class="blueButton whitePath">
            <Phone />
            <p>01782 749000</p>
          </a>
          <a class="hollowButton whitePath" href="mailto:info@bowson.co.uk">
            <Mail />
            <p>info@bowson.co.uk</p>
          </a>
        </div>
      </div>
      <HeadingInfo />
    </div>
  </div>
  <div class="mainBlock">
    <ContactInfo />
  </div>
  <div class="darkerBg">
    <WhiteForms />
  </div>
  <div class="mainBlock mainBlockGrid">
    <div class="mainBlockText">
      <p class="blueTitle">Find us</p>
      <div class="textBlock">
        <h2 class="h2Title h2TitleFullWidth">Right in the heart of Stoke-On-Trent</h2>
        <h3 class="h2TitleFullWidth">Our Fenton workshop is a few minutes from the A500 and easily reached from the M6. Visitor parking is available on-site — call ahead so we can have the kettle on.</h3>
      </div>
      <a class="blueButton whitePath" href="https://maps.app.goo.gl/MSDCLWn35raHv1AEA" target="_blank" rel="noopener noreferrer">
        <p>Open in Google Maps</p>
        <Arrow />
      </a>
    </div>
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2847.577491747471!2d-2.1628440232890056!3d53.00971617219355!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487a69c66d4d60fd%3A0xaf88897079a0e688!2sBowson%20Engineering%20Limited!5e1!3m2!1sen!2suk!4v1790261104353!5m2!1sen!2suk"
      width="600"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  <Faqs darkerBg={true} questionData={questionData} />
</section>

<style lang="scss">
  @use '../../styles/breakpoints' as *;
  .gradientBg {
    position: relative;
    z-index: 1;
    --heroHeight: 826px;
    height: var(--heroHeight);
    background: linear-gradient(135deg, #0b3a5e 0%, #0f7ab0 100%);

    @include bp(lg) {
      --heroHeight: 565px;
    }
  }

  .mainBlockGrid {
    grid-template-columns: 0.4fr 1fr;
  }

  .sectionLeftContact {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .sectionImgOverCol {
    display: flex;
    flex-direction: column;
    gap: 28px;

    @include bp(lg) {
      display: grid;
      grid-template-columns: 1.4fr 1fr; // check Figma's actual column ratio, may not be 50/50
      align-items: center;
    }

    @include bp(xl) {
      margin-inline: auto;
      max-width: 1440px;
    }

    .sectionTopDesc {
      width: 100%;
    }

    h1 {
      width: 100%;
    }
  }

  .contactBubble {
    width: fit-content;
    height: 30.9px;
    background: rgba(255, 255, 255, 0.08);
    border: 0.8px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 0 20px;

    p {
      color: #fff !important;
    }
  }

  h1 {
    color: #fff !important;
  }

  .underline {
    text-decoration: underline;
  }

  .hollowButton {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
  }

  iframe {
    width: 100%;
    border-radius: 16px;
  }
</style>
