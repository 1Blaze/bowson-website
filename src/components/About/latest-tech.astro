---
import { Image } from 'astro:assets';
import Solidworks from '@assets/images/solidworks.webp'
import type { ServiceKitType } from '~/src/data/services'
import Reveal from "../reveal.astro";

const latestTechnology: ServiceKitType[] = [
  {
    image: Solidworks,
    title: 'Solidworks 3D CAD',
    description: 'From concept to production-ready drawings.'
  }
]
---

<!-- TEXT: SORT THIS -->
<div class="servicesDisplay">
  {
    latestTechnology.map((item, i) => (
      <Reveal from="down" delay={i * 70}>
        <div class="technologyItem">
          <div class="techImg">
            <Image src={item.image} alt={item.title} />
          </div>
          <div class="serviceTextGap">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </div>
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .technologyItem {
    // width: 335.2px;
    width: 100%;
    // transition: 0.2s;
    // cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    flex-direction: row;
    text-decoration: none;
    overflow: hidden;
    height: 133.2px;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 12px;

    @include bp(lg) {
      height: 80px;
    }
    // gap: 16px;

    .techImg {
      padding: 0 18px;
      width: 191px;
    }

    img {
      width: 100%;
      height: 32px;
    }

    h3 {
      font-family: var(--font-barlow);
      font-style: normal;
      font-weight: 700;
      font-size: 20px;
      color: #0f172a;
    }

    p {
      font-weight: 400;
      font-size: 14px;
      color: #4b5563;
    }

    .serviceTextGap {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 28px;

      @include bp(lg) {
        padding: 0px;

        h3 {
          font-size: 14px;
        }

        p {
          font-size: 12px;
        }
      }
    }

    // &:hover {
    //   box-shadow:
    //     0px 4px 6px -4px rgba(0, 0, 0, 0.2),
    //     0px 10px 15px -3px rgba(0, 0, 0, 0.2);
    //   transform: translateY(-5px);
    //   scale: 1.01;
    // }
  }

  .servicesDisplay {
    @include bp(lg) {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  }
</style>
