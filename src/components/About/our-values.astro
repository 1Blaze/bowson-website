---
import Reveal from '../reveal.astro';
import Stars from '@assets/svgs/stars.svg';
import Sheild from '@assets/svgs/shield.svg';
import Factory from '@assets/svgs/factory.svg';
import Lightning from '@assets/svgs/lightning.svg';
import GreySvgBox from '../grey-svg-box.astro';

type ServiceType = {
  title: string;
  description: string;
  svg: typeof Stars;
};

const services: ServiceType[] = [
  {
    title: 'Quality & reliability',
    description: 'Accurate, repeatable work, whether it is a custom one-off or a larger batch run, from a business that has been making sheet metal products since 1990.',
    svg: Sheild,
  },
  {
    title: 'Fast turnaround',
    description: 'Quotes within 24 hours, and punching, bending, rolling, welding and powder coating in our own workshop keep your job moving from enquiry to dispatch.',
    svg: Lightning,
  },
  {
    title: 'Bespoke by design',
    description: 'We look at your design from the outset and find cost-effective ways to make it, using SolidWorks to refine the part before manufacture.',
    svg: Stars,
  },
  {
    title: 'Family-owned values',
    description: 'Established in 1990 and still run by the family, now in its third generation, with direct relationships and straight answers.',
    svg: Factory,
  },
];
---

<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="left">
        <GreySvgBox {...service} />
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .servicesDisplay {
    @include bp(lg) {
      grid-template-columns: 1fr 1fr 1fr 1fr;
      gap: 25px;
    }
  }
</style>
