---
import '../Reused.scss';
import { Image } from 'astro:assets';
import RollerTable from '@assets/images/about_image.webp'
// TODO: when possible get a picture of potterycrafts on the van
import Punch from '@assets/images/services/punch.webp'
import Welding from '@assets/images/services/weld.webp';
import Powdercoating from '@assets/images/services/oven.webp';
import Modelling from '@assets/images/services/3dmodelling.webp';
import Press from '@assets/images/xpert_pro_130.webp'
import InfoGrid from "../info-grid.astro";
import OurValues from "./our-values.astro";
import OurStory from "./our-story.astro";
import Reveal from "../reveal.astro";
import Phone from '@assets/svgs/phone.svg'
import SmallDot from '@assets/svgs/small-dot.svg'
import CallToAction from '../call-to-action.astro';
import LatestTech from './latest-tech.astro';
import BespokeProducts from './bespoke-products.astro';
import type { ServiceKitType } from '~/src/data/services';

const capabilities: ServiceKitType[] = [
  {
    image: Punch,
    title: 'Trumpf TC200 turret punch',
    description: 'Trumpf CNC punching and laser cutting for clean, accurate profiles in steel, stainless and aluminium.',
    imageAlt: 'Turret punch tooling punching a pattern of rectangular holes in a steel sheet',
  },
  {
    image: Welding,
    imageAlt: 'MIG welding a steel plate with a bright blue arc and sparks',
    title: 'Bending & Fabrication',
    description: 'Press brake forming and skilled MIG/TIG welding for fully fabricated assemblies built to drawing.',
  },
  {
    image: Powdercoating,
    imageAlt: 'Purple powder coated steel discs and brackets hanging in a coating booth',
    title: 'Powder Coating',
    description: 'In-house powder coating line with a wide range of standard and custom colour finishes.',
  },
  {
    image: Modelling,
    imageAlt: '3D CAD model of a large steel oven frame with a pull-out tray',
    title: 'Solidworks 3D Design',
    description: 'Concept to production drawings in SolidWorks — collaborate with us to refine new or existing products.',
  },
]

---

<!-- TEXT: SORT THIS -->
<section class="section home">
  <div class="topGap">
    <div class="intro">
      <div class="established">
        <SmallDot />
        <p>About Bowson Engineering</p>
      </div>
      <div class="topTextGap">
        <h1>A Stoke-on-Trent family business built on quality, reliability and engineering know-how.</h1>
        <p class="homeDesc">Bowson Engineering Ltd was established in 1990 and is based in Fenton, Stoke-on-Trent. We are a family-owned company with strong values at the heart of our business. Our core capability is the manufacture of bespoke sheet metal products — supplied individually or combined with CNC punching, laser cutting, bending, fabrication and powder coating.</p>
      </div>
      <div class="buttonRow">
        <a href="/contact-us" class="orangeButton"><p>Request a Quote</p></a>
        <a href="tel:+441782749000" class="centerFlex phoneGap">
          <Phone />
          <p>01782 749000</p>
        </a>
      </div>
    </div>
    <div class="imgHouse">
      <Image src={RollerTable} alt={'Picture of multiple kilns in a green and grey colour on the bowson engineering transport van'} />
      <div class="yearsIn">
        <h4>35+</h4>
        <p>Years in business</p>
      </div>
    </div>
  </div>
  <InfoGrid borderAndBg={true} />
  <div class="mainBlock mainBlockGridEqual">
    <div class="mainBlockText">
      <p class="blueTitle">Our Story</p>
      <div class="textBlock">
        <h2 class="h2Title h2TitleFullWidth">Three decades of bespoke sheet metal.</h2>
        <h3 class="h2TitleFullWidth">From a small Stoke-on-Trent workshop to a full in-house manufacturing facility — built on the same family values we started with.</h3>
      </div>
    </div>
    <OurStory />
  </div>
  <div class="darkerBg">
    <div class="mainBlock">
      <div class="mainBlockText">
        <p class="blueTitle titleCentre">Our Values</p>
        <div class="textBlock">
          <h2 class="h2Title titleCentre h2TitleFullWidth">What you can expect from working with us.</h2>
        </div>
      </div>
      <OurValues />
    </div>
  </div>
  <div class="mainBlock">
    <div class="mainBlockText">
      <p class="blueTitle">In-house Capabilitiy</p>
      <div class="textBlock">
        <h2 class="h2Title">Design, cut, bend, weld and coat — all under one roof.</h2>
        <h3>By keeping every stage of manufacture in-house, we control quality, shorten lead times and pass cost savings back to our customers.</h3>
      </div>
    </div>
    <div class="servicesDisplay">
      {
        capabilities.map((item, i) => (
          <Reveal from="right" delay={i * 70}>
            <a class="serviceItem" href="/services">
              <Image src={item.image} alt={item.imageAlt} />
              <div class="serviceTextGap">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </a>
          </Reveal>
        ))
      }
    </div>
  </div>
  <div class="darkerBg">
    <div class="topGap">
      <Reveal from="left">
        <div class="aboutImage">
          <Image class="img" src={Press} alt={'A Bystronic Xpert Pro 130'} />
        </div>
      </Reveal>
      <Reveal from="right">
        <div class="mainBlockNoPadding">
          <div class="mainBlockText">
            <p class="blueTitle">Latest Technology</p>
            <div class="textBlock">
              <h2 class="h2Title h2TitleFullWidth">Investing in machinery that delivers precision and pace.</h2>
              <h3 class="h2TitleFullWidth">Our shop floor combines a Trumpf Trumatic CNC punch, laser cutting and an Xpert Pro CNC press brake bender with skilled welders and an in-house powder coating line. The result is consistent, repeatable accuracy across one-offs and production runs alike.</h3>
            </div>
          </div>
          <LatestTech />
        </div>
      </Reveal>
    </div>
  </div>
  <div class="mainBlock mainBlockGrid">
    <div class="mainBlockText">
      <p class="blueTitle">Bespoke Experience</p>
      <div class="textBlock">
        <h2 class="h2Title h2TitleFullWidth">A range of custom products we've engineered.</h2>
        <h3 class="h2TitleFullWidth">From safety-critical structures to specialist storage and cabinets — we work across sectors and applications.</h3>
      </div>
    </div>
    <BespokeProducts />
  </div>
  <CallToAction />
</section>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .imgHouse {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    width: 100%;
    height: 251.4px;
    box-shadow:
      0px 6px 12px -6px rgba(15, 23, 42, 0.08),
      0px 12px 30px -10px rgba(2, 132, 199, 0.25);
    border-radius: 16px;
    // overflow: hidden;

    img {
      height: 100%;
      width: 100%;
      border-radius: 16px;
      object-fit: cover;
    }

    .yearsIn {
      position: absolute;
      width: fit-content;
      height: 80.5px;

      background: #0393cf;
      box-shadow:
        0px 6px 12px -6px rgba(15, 23, 42, 0.08),
        0px 12px 30px -10px rgba(2, 132, 199, 0.25);
      border-radius: 12px;
      bottom: -15px;
      right: -15px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      // align-items: center;
      padding: 0 20px;

      h4 {
        font-family: var(--font-barlow);
        font-weight: 700;
        font-size: 30px;
        color: #ffffff;
      }

      p {
        font-weight: 600;
        font-size: 11.2px;
        color: #ffffff;
      }
    }
  }

  .serviceItem {
    img {
      height: 208px;
      object-fit: cover;

      @include bp(lg) {
        height: 160px;
      }
    }

    .serviceTextGap {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 16px;
    }

    h3 {
      font-size: 16px;
      width: 100%;
    }
  }

  .servicesDisplay {
    @include bp(lg) {
      grid-template-columns: 1fr 1fr 1fr 1fr;
      gap: 25px;
    }
  }

  .topGap {
    @include bp(lg) {
      grid-template-columns: 1fr 1fr;
    }

    .imgHouse {
      @include bp(lg) {
        height: 438px !important;
      }
    }
  }

  .aboutImage {
    display: none;
    border-radius: 16px;
    width: 90%;
    aspect-ratio: 478 / 360;
    background: linear-gradient(to bottom right, #fde9de 0%, #fef3ee 25%, #ffffff 50%, #eef7fb 75%, #dceef7 100%);
    justify-content: center;
    align-items: center;
    position: relative;

    @include bp(lg) {
      display: flex;
    }

    .img {
      width: 93%;
      height: 93%;
      border: 1px solid #e5e9f0;
      box-shadow:
        0px 6px 12px -6px rgba(15, 23, 42, 0.08),
        0px 12px 30px -10px rgba(2, 132, 199, 0.25);
      border-radius: 12px;
      object-fit: cover;
    }
  }
</style>
