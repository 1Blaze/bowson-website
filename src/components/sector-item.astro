---
import { Image } from 'astro:assets';
import Arrow from '@assets/svgs/arrow-button.svg'

export type SectorItemType = {
  orangeText: string;
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  description: string;
  cta: string;
  href: string;
  selected: boolean;
  coverFit?: boolean;
  clipText?: boolean;
}

interface Props extends SectorItemType {

}

const {orangeText, title, description, cta, href, selected, image, imageAlt, clipText} = Astro.props
---

<a class={selected ? 'sectorItem sectorItemFeatured' : 'sectorItem'} href={`${href}`}>
  <div class="imgBg">
    <Image src={image} alt={imageAlt} />
    <div class="imgOverlay"></div>
  </div>
  <div class="sectorOverImg">
    <span>{orangeText}</span>
    <div>
      <p class="title">{title}</p>
      <p class={clipText ? 'clipText description' : 'description'}>{description}</p>
    </div>
    <div class="serviceLearnMore orangePath">
      <p class="cta">{cta}</p>
      <Arrow />
    </div>
  </div>
</a>

<style lang="scss">
  .clipText {
    // white-space: nowrap;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
