---
import { Image } from 'astro:assets';
import Punch from '@assets/images/Punch_TODO_Change.webp'
// interface Props {
//     orangeText: string;
//     title: string;
//     description: string;
//     cta: string
// }

// const {orangeText, title, description, cta} = Astro.props
---

<a class="sectorItem" href="/">
  <!-- {title} -->
  <div class="imgBg">
    <Image src={Punch} alt="Trumpf CNC Punch TODO Change" />
    <div class="imgOverlay"></div>
  </div>
  <div class="sectorOverImg">fart</div>
</a>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .sectorItem {
    --heroHeight: 260px;
    height: --heroHeight;
    width: 100%;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    z-index: 1;
    text-decoration: none;
    cursor: pointer;
    transition: 0.3s;

    .imgBg {
      position: relative;
      z-index: 1;
      height: 100%;
      height: var(--heroHeight);

      img {
        height: 100%;
        width: 100%;
        object-fit: cover;
      }

      .imgOverlay {
        position: absolute;
        top: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(14, 22, 40, 0) 0%, rgba(14, 22, 40, 0.97) 100%);
        background-blend-mode: overlay;
        opacity: 0.9;
      }
    }

    .sectorOverImg {
      position: absolute;
      z-index: 2;
      top: 0;
      min-height: var(--heroHeight);
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 28px;
      inset-inline: 0;
    }

    &:hover {
      box-shadow:
        0px 4px 6px -4px rgba(0, 0, 0, 0.2),
        0px 10px 15px -3px rgba(0, 0, 0, 0.2);
      transform: translateY(-5px);
      scale: 1.01;
    }
  }
</style>
