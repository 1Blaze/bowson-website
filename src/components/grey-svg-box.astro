---
import Shield from '@assets/svgs/shield.svg';

export type ServiceType = {
  title: string;
  description: string;
  svg: typeof Shield;
};

interface Props extends ServiceType {}

const {title, description, svg} = Astro.props

const Icon = svg
---

<div class="howWeWork">
  <div class="svgHouse">
    <Icon />
  </div>
  <div class="textGap">
    <p>{title}</p>
    <span>{description}</span>
  </div>
</div>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .howWeWork {
    width: 100%;
    height: fit-content;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 22px;

    .svgHouse {
      width: 44px;
      height: 44px;
      background: rgba(2, 132, 199, 0.1);
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .textGap {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    p {
      font-family: var(--font-barlow);
      font-weight: 700;
      font-size: 18px;
      color: #0f172a;
    }

    span {
      font-weight: 400;
      font-size: 14px;
      color: #4b5563;
    }
  }
</style>
