---
import Image from 'astro/components/Image.astro';
import logo from '@assets/images/Logo.webp';
import Phone from '@assets/svgs/phone.svg';
import Mail from '@assets/svgs/mail.svg';
import Clock from '@assets/svgs/clock.svg';
import Location from '@assets/svgs/location.svg';
import YoutubeIcon from './Icons/Youtube.astro';
import FacebookIcon from './Icons/Facebook.astro';
import LinkedIn from './Icons/LinkedIn.astro';

const socialMedias = [
    { name: 'YouTube', href: 'https://www.youtube.com/@bowsonengineering', Icon: YoutubeIcon },
    { name: 'Facebook', href: 'https://www.facebook.com/BowsonEng', Icon: FacebookIcon },
    { name: 'LinkedIn', href: 'https://www.linkedin.com/company/5650038', Icon: LinkedIn}
]

const explore = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about-us' },
  { name: 'Projects', href: '/projects' },
  { name: 'Sectors', href: '/sectors' },
  { name: 'Contact', href: '/contact-us' },
  { name: 'Services', href: '/services' },
]

const services = [
  { name: 'CNC Punching', href: '/services/cnc-punching' },
  { name: 'Bending / Metal Forming', href: '/services/bending-metal-forming' },
  { name: 'Welding / Fabrication', href: '/services/welding-fabrication' },
  { name: 'Powder Coating', href: '/services/powder-coating' },
  { name: '3D Cad Design', href: '/services/3d-cad-design' },
  { name: 'Laser Cutting', href: '/services/laser-cutting' },
]

type VisitType = {
  name: string;
  svg: typeof Phone;
  href: string
};

const visits: VisitType[] = [
  { name: '01782 749000', svg: Phone, href: 'tel:+441782749000' },
  { name: 'info@bowson.co.uk', svg: Mail, href: 'mailto:info@bowson.co.uk' },
]
---

<!-- TEXT: SORT THIS -->
<footer class="footer">
  <div class="footerPadding">
    <div class="footerSocials">
      <div class="footerTop">
        <div class="imageHouse"><a href="/"><Image src={logo} alt="Bowson Engineering Logo" /></a></div>
        <p>Established in 1990 and based in Stoke-on-Trent, Bowson Engineering is a family-owned sheet metal manufacturer specialising in CNC punching, laser cutting, bending, fabrication and powder coating.</p>
      </div>
      <div class="socials">
        {
          socialMedias.map(({ name, href, Icon }) => (
            <a class="socialLogo" href={href} target="_blank" rel="noopener noreferrer" aria-label={name}>
              <Icon />
            </a>
          ))
        }
      </div>
    </div>
    <div class="footerRow">
      <div class="footerLinks">
        <p class="footerBold">Explore</p>
        <ul>
          {
            explore.map((item) => (
              <li>
                <a href={item.href}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footerLinks">
        <p class="footerBold">Services</p>
        <ul>
          {
            services.map((item) => (
              <li>
                <a href={item.href}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="footerVisit">
      <p class="footerBold">Visit Us</p>
      <ul class="visitList bluePath footerSvgs">
        <li>
          <a href="https://maps.app.goo.gl/MSDCLWn35raHv1AEA" target="_blank" rel="noopener noreferrer">
            <Location />
            <address>Oak House, Dewsbury Road Fenton Ind Est, Fenton Stoke-on-Trent, ST4 2TE</address>
          </a>
        </li>
        {
          visits.map((item) => {
            const Icon = item.svg;
            return (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  <Icon />
                  <p>{item.name}</p>
                </a>
              </li>
            );
          })
        }
        <li>
          <div class="timings">
            <Clock />
            <div>
              <!-- TODO change times on google to match this -->
              <div class="timeRow">
                <span>Mon-Thu</span>
                <time datetime="07:30">7:30</time><span>–</span><time datetime="15:30">15:30</time>
              </div>
              <div class="timeRow">
                <span>Friday:</span>
                <time datetime="07:30">7:30</time><span>–</span><time datetime="12:30">12:30</time>
              </div>
              <div class="timeRow">
                <span>Sat-Sun:</span>
                <span>Closed</span>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </div>
  <div class="footerBottomHouse">
    <div class="footerBottom"><p>© 2026 Bowson Engineering Limited. All rights reserved.</p><p>Registered in England · Stoke-on-Trent, United Kingdom</p></div>
  </div>
</footer>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .footer {
    width: 100%;
    background-color: #0f172a;

    .footerSocials {
      display: flex;
      flex-direction: column;
      gap: 48px;
    }

    .footerPadding {
      padding: 48px 20px;
      display: flex;
      flex-direction: column;
      gap: 48px;

      @include bp(lg) {
        padding: 48px 100px;
        display: grid;
        grid-template-columns: 1fr 1.5fr 1fr;
        justify-content: center;
        // margin-inline: auto;
        // max-width: 1440px;
      }

      @include bp(xl) {
        padding: 48px 0px;
        margin-inline: auto;
        max-width: 1440px;
      }
    }

    .footerTop {
      display: flex;
      flex-direction: column;
      gap: 22px;

      p {
        font-weight: 400;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
      }
    }

    .imageHouse {
      width: 132.46px;
      height: 60px;
      background: #ffffff;
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;

      img {
        width: 109px;
        height: 36px;
      }
    }

    .socials {
      display: flex;
      flex-direction: row;
      gap: 15px;

      .socialLogo {
        width: 40px;
        height: 40px;
        border: 0.8px solid rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        background: transparent;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        justify-content: center;
        align-items: center;

        &:hover {
          background-color: #0393cf;
          border-color: #0393cf;
        }
      }
    }

    .footerBold {
      font-family: var(--font-barlow);
      font-weight: 600;
      font-size: 14px;
      color: #ffffff;
    }

    .footerRow {
      display: flex;
      flex-direction: row;
    }

    .footerVisit {
      display: flex;
      flex-direction: column;
      gap: 15px;

      ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .timings,
      a {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        width: 60%;
        text-decoration: none;

        svg {
          flex-shrink: 0;
          margin-top: 0.075rem; // nudge to align with text baseline
        }

        p,
        address {
          text-decoration: none;
          font-weight: 400;
          font-size: 14px;
          color: rgba(255, 255, 255, 0.7);
          cursor: pointer;
          transition: 0.3s;
          font-style: normal;

          &:hover {
            color: #0393cf !important;
          }
        }

        span,
        time {
          text-decoration: none;
          font-weight: 400;
          font-size: 14px;
          color: rgba(255, 255, 255, 0.7);
          font-style: normal;
        }
      }

      .timeRow {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 5px;
        // justify-content: space-between;
      }
    }

    .footerLinks {
      width: 50%;
      display: flex;
      flex-direction: column;
      gap: 15px;

      ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 15px;
      }

      li {
        a {
          text-decoration: none;
          font-weight: 400;
          font-size: 14px;
          color: rgba(255, 255, 255, 0.7);
          cursor: pointer;
          transition: 0.3s;

          &:hover {
            color: #0393cf !important;
          }
        }
      }
    }

    .footerBottomHouse {
      height: 96px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      width: 100%;

      @include bp(lg) {
        flex-direction: row;
        justify-content: space-between;
      }
    }

    .footerBottom {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      gap: 12px;
      position: relative;
      height: 100%;

      p {
        font-weight: 400;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.55);
      }

      @include bp(lg) {
        flex-direction: row;
        justify-content: space-between;
        max-width: 1440px;
        margin-inline: auto;
      }
    }
  }
</style>
