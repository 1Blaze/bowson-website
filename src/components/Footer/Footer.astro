---
import Image from 'astro/components/Image.astro';
import logo from '@assets/images/Logo.webp';
import YoutubeIcon from './Icons/Youtube.astro';
import FacebookIcon from './Icons/Facebook.astro';
import LinkedIn from './Icons/LinkedIn.astro';

const socialMedias = [
    { name: 'YouTube', href: 'https://youtube.com/@TODO', Icon: YoutubeIcon },
    { name: 'Facebook', href: 'https://www.facebook.com/BowsonEng', Icon: FacebookIcon },
    { name: 'LinkedIn', href: 'https://www.linkedin.com/company/5650038', Icon: LinkedIn}
]

const explore = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about-us' },
  { name: 'Projects', href: '/projects' },
  { name: 'Sectors', href: '/sectors' },
  { name: 'Contact', href: '/contact-us' },
  { name: 'Services', href: '/services' },
]

const services = [
  { name: 'CNC Punching', href: '/services/cnc-punching' },
  { name: 'Bending / Metal Forming', href: '/services/bending-metal-forming' },
  { name: 'Welding / Fabrication', href: '/services/welding-fabrication' },
  { name: 'Powder Coating', href: '/services/powder-coating' },
  { name: '3D Cad Design', href: '/services/3d-cad-design' },
  { name: 'Laser Cutting', href: '/services/laser-cutting' },
]
---

<footer class="footer">
  <div class="footerPadding">
    <div class="footerSocials">
      <div class="footerTop">
        <div class="imageHouse"><a href="/"><Image src={logo} alt="Bowson Engineering Logo" /></a></div>
        <p>Established in 1990 and based in Stoke-on-Trent, Bowson Engineering is a family-owned sheet metal manufacturer specialising in CNC punching, laser cutting, bending, fabrication and powder coating.</p>
      </div>
      <div class="socials">
        {
          socialMedias.map(({ name, href, Icon }) => (
            <a class="socialLogo" href={href} target="_blank" rel="noopener noreferrer" aria-label={name}>
              <Icon />
            </a>
          ))
        }
      </div>
    </div>
    <div class="footerRow">
      <div class="footerLinks">
        <p class="footerBold">Explore</p>
        <ul>
          {
            explore.map((item) => (
              <li>
                <a href={item.href}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footerLinks">
        <p class="footerBold">Services</p>
        <ul>
          {
            services.map((item) => (
              <li>
                <a href={item.href}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="footerVisit">
      <p class="footerBold">Visit Us</p>
      <ul class="visitList">
        <li>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path
              d="M8.40067 14.5323C9.64067 13.4617 13.3333 9.99501 13.3333 6.66634C13.3333 5.25185 12.7714 3.8953 11.7712 2.89511C10.771 1.89491 9.41449 1.33301 8 1.33301C6.58551 1.33301 5.22896 1.89491 4.22876 2.89511C3.22857 3.8953 2.66667 5.25185 2.66667 6.66634C2.66667 9.99501 6.35933 13.4617 7.59933 14.5323C7.71485 14.6192 7.85547 14.6662 8 14.6662C8.14453 14.6662 8.28515 14.6192 8.40067 14.5323Z"
              stroke="#0393CF"
              stroke-width="1.33333"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path d="M8 8.66699C9.10457 8.66699 10 7.77156 10 6.66699C10 5.56242 9.10457 4.66699 8 4.66699C6.89543 4.66699 6 5.56242 6 6.66699C6 7.77156 6.89543 8.66699 8 8.66699Z" stroke="#0393CF" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <!-- TODO: make them all svgs -->
          <p>Oak House, Dewsbury Road Fenton Ind Est, Fenton Stoke-on-Trent, ST4 2TE</p>
        </li>
        <!-- TODO: make all the stuff work etc -->
      </ul>
    </div>
  </div>
  <div class="footerBottomHouse">
    <div class="footerBottom"><p>© 2026 Bowson Engineering Limited. All rights reserved.</p><p>Registered in England · Stoke-on-Trent, United Kingdom</p></div>
  </div>
</footer>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .footer {
    width: 100%;
    background-color: #0f172a;

    .footerSocials {
      display: flex;
      flex-direction: column;
      gap: 48px;
    }

    .footerPadding {
      padding: 48px 20px;
      display: flex;
      flex-direction: column;
      gap: 48px;

      @include bp(lg) {
        padding: 48px 100px;
        display: grid;
        grid-template-columns: 1fr 1.5fr 1fr;
        justify-content: center;
        // margin-inline: auto;
        // max-width: 1440px;
      }

      @include bp(xl) {
        padding: 48px 0px;
        margin-inline: auto;
        max-width: 1440px;
      }
    }

    .footerTop {
      display: flex;
      flex-direction: column;
      gap: 22px;

      p {
        font-weight: 400;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
      }
    }

    .imageHouse {
      width: 132.46px;
      height: 60px;
      background: #ffffff;
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;

      img {
        width: 109px;
        height: 36px;
      }
    }

    .socials {
      display: flex;
      flex-direction: row;
      gap: 15px;

      .socialLogo {
        width: 40px;
        height: 40px;
        border: 0.8px solid rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        background: transparent;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        justify-content: center;
        align-items: center;

        &:hover {
          background-color: #0393cf;
          border-color: #0393cf;
        }
      }
    }

    .footerBold {
      font-family: var(--font-barlow);
      font-weight: 600;
      font-size: 14px;
      color: #ffffff;
    }

    .footerRow {
      display: flex;
      flex-direction: row;
    }

    .footerVisit {
      display: flex;
      flex-direction: column;
      gap: 15px;

      ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      li {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        width: 60%;

        svg {
          flex-shrink: 0;
          margin-top: 0.15rem; // nudge to align with text baseline
        }

        p {
          text-decoration: none;
          font-weight: 400;
          font-size: 14px;
          color: rgba(255, 255, 255, 0.7);
          cursor: pointer;
          transition: 0.3s;

          &:hover {
            color: #0393cf !important;
          }
        }
      }
    }

    .footerLinks {
      width: 50%;
      display: flex;
      flex-direction: column;
      gap: 15px;

      ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 15px;
      }

      li {
        a {
          text-decoration: none;
          font-weight: 400;
          font-size: 14px;
          color: rgba(255, 255, 255, 0.7);
          cursor: pointer;
          transition: 0.3s;

          &:hover {
            color: #0393cf !important;
          }
        }
      }
    }

    .footerBottomHouse {
      height: 96px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      width: 100%;

      @include bp(lg) {
        flex-direction: row;
        justify-content: space-between;
      }
    }

    .footerBottom {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      gap: 12px;
      position: relative;
      height: 100%;

      p {
        font-weight: 400;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.55);
      }

      @include bp(lg) {
        flex-direction: row;
        justify-content: space-between;
        max-width: 1440px;
        margin-inline: auto;
      }
    }
  }
</style>
