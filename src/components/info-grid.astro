---
import Calendar from '@assets/svgs/calendar.svg'
import Factory from '@assets/svgs/factory.svg'
import Family from '@assets/svgs/family.svg'
import Merit from '@assets/svgs/merit.svg'
import Reveal from './reveal.astro'

interface Props {
  borderAndBg: boolean
}

const borderAndBg = Astro.props.borderAndBg
---

<Reveal>
  <div class={borderAndBg ? 'infoGridWrapperBorderBg' : 'infoGridWrapper'}>
    <div class="infoGrid">
      <div class="gridItem">
        <div class="icon"><Calendar /></div>
        <div><p>1990</p><span>Established</span></div>
      </div>
      <div class="gridItem">
        <div class="icon"><Family /></div>
        <div><p>3rd Generation</p><span>Family Owned</span></div>
      </div>
      <div class="gridItem">
        <div class="icon"><Factory /></div>
        <div><p>Multiple processes</p><span>Under one roof</span></div>
      </div>
      <div class="gridItem">
        <div class="icon"><Merit /></div>
        <div><p>One-offs → Batch</p><span>Flexible Production</span></div>
      </div>
    </div>
  </div>
</Reveal>
