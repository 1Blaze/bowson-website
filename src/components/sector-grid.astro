---
import { Image } from 'astro:assets';
import Ceramics from '@assets/images/Sectors/ceramics.webp';
import RollerTable from '@assets/images/Sectors/rollers.webp';
import Stillage from '@assets/images/Sectors/stillage.webp';
import Guard from '@assets/images/Sectors/machineguard.webp';
import Seatbed from '@assets/images/Sectors/seatbed.webp';
import Tower from '@assets/images/Sectors/tower.webp';
import Arrow from '@assets/svgs/arrow-button.svg'
import Reveal from './reveal.astro';
import type { SectorItemType } from './sector-item.astro';

// TEXT: SORT THIS
export const SectorItems: SectorItemType[] = [
  {
    orangeText: 'Sector',
    title: 'Manufacturing',
    description: 'Cabinets, enclosures and machine parts for production lines',
    cta: 'Explore sector',
    selected: true,
    href: 'manufacturing-production',
    image: RollerTable,
    coverFit: true,
    imageAlt: 'White steel roll stand holding rolls of material beside a cutting table',
  },
  {
    orangeText: 'Sector',
    title: 'Agriculture & Estate',
    description: 'Galvanised steel deer towers and dog kennel structures.',
    cta: 'Explore sector',
    selected: false,
    href: 'agriculture-estate',
    image: Tower,
    imageAlt: 'Galvanised steel deer tower with an enclosed cabin and ladder in woodland',
  },
  {
    orangeText: 'Sector',
    title: 'Ceramics & Pottery',
    description: 'Kilns, kiln frames, hoods and ventilation canopies, powder coated in-house.',
    cta: 'Explore sector',
    selected: false,
    href: 'ceramics-pottery',
    image: Ceramics,
    imageAlt: 'Blue powder coated steel kiln frame with a hood section on top',
  },
  {
    orangeText: 'Sector',
    title: 'Material Handling & Storage',
    description: 'Stillages, pallet gates and bottle cages for moving and storing product.',
    cta: 'Explore sector',
    selected: false,
    href: 'material-handling-storage',
    image: Stillage,
    coverFit: true,
    imageAlt: 'White steel stillage with grey fabric dividers',
  },
  {
    orangeText: 'Sector',
    title: 'Safety & Access',
    description: 'Machine guarding, safety barriers, access platforms, mobile steps, and smoking shelters.',
    cta: 'Explore sector',
    selected: false,
    href: 'safety-access',
    image: Guard,
    imageAlt: 'Steel mesh machine guarding with a gate and yellow safety barrier around production equipment',
  },
  {
    orangeText: 'Sector',
    title: 'Vehicle & Campervan Conversions',
    description: 'Seatbeds, roof bars and mounting plates for campervan conversions.',
    cta: 'Explore sector',
    selected: false,
    href: 'vehicle-campervan-conversions',
    image: Seatbed,
    imageAlt: 'Black steel campervan seatbed frame with seatbelts and red release buttons',
  },
]

---

<div class="servicesDisplay">
  {
    SectorItems.map((service, i) => (
      <Reveal delay={i * 70}>
        <a href={`/sectors/${service.href}`} class="serviceItem">
          <Image class={service.coverFit ? 'imgCoverFit' : ''} src={service.image} alt={service.imageAlt} />
          <div class="serviceTextGap">
            <h3 class="h2TitleFullWidth">{service.title}</h3>
            <p>{service.description}</p>
            <div class="serviceLearnMore">
              <span>Learn more</span>
              <Arrow />
            </div>
          </div>
        </a>
      </Reveal>
    ))
  }
</div>
