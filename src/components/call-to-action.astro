---
import ArrowQuote from '@assets/svgs/arrow-quote.svg'
import Phone from '@assets/svgs/phone.svg'
import Mail from '@assets/svgs/mail.svg'
---

<div class="callToActionDark">
  <div class="callToActionWrapper">
    <div class="callToAction">
      <div class="top">
        <div class="topBlob2"></div>
        <div class="topBlob1"></div>
        <div class="topText">
          <span>Start your project</span>
          <h3>Ready to get a quotation?</h3>
          <p>Call us to discuss your requirements or fill in the form and a member of our team will get back to you with a no-obligation quote.</p>
        </div>
        <div class="topDesc">
          <a href="tel:+441782749000" class="topRow">
            <div class="iconBox whitePath">
              <Phone />
            </div>
            <div class="iconText">
              <span>Call Us</span>
              <p>01782 749000</p>
            </div>
          </a>
          <a href="mailto:info@bowson.co.uk" class="topRow">
            <div class="iconBox">
              <Mail />
            </div>
            <div class="iconText">
              <span>Email</span>
              <p>info@bowson.co.uk</p>
            </div>
          </a>
        </div>
      </div>

      <form class="form" action="https://api.web3forms.com/submit" method="POST" novalidate>
        <input type="hidden" name="access_key" value="76671095-15eb-4056-aee2-01748f9ecf42" />
        <input type="hidden" name="subject" value="New RFQ — Bowson Engineering website" />
        <input type="hidden" name="from_name" value="Bowson Engineering website" />
        {
          /* Honeypot: real users never see or fill this. Bots often do. Web3Forms
      auto-rejects submissions where this field is non-empty. */
        }
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="formGrid">
          <div class="formCol">
            <label for="name" class="required">Your Name</label>
            <input type="text" id="name" name="name" autocomplete="name" required placeholder="Jane Smith" />
          </div>
          <div class="formCol">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" autocomplete="company" required placeholder="Business Ltd" />
          </div>
          <div class="formCol">
            <label for="email" class="required">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required placeholder="you@email.co.uk" />
          </div>
          <div class="formCol">
            <label for="phone" class="required">Phone Number</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" required placeholder="07900 000000" />
          </div>
        </div>
        <div class="formCol">
          <label for="desc" class="required">Tell us about your project</label>
          <textarea id="desc" name="desc" required placeholder="Description, quantities, materials, any other information available..."></textarea>
        </div>
        <div class="formRow">
          <span>We aim to response within one working day.</span>
          <button class="orangeButton" type="submit">
            <p>Request a Quote</p>
            <ArrowQuote />
          </button>
        </div>
        <!-- TODO: change form to live and to my email -->
      </form>
    </div>
  </div>

  <style lang="scss">
    @use '../styles/breakpoints' as *;

    .callToActionDark {
      background-color: #f8fafc;
    }

    .callToActionWrapper {
      padding: 35px 26px;

      @include bp(lg) {
        padding: 50px 100px;
        // padding-bottom: 75px;
        // margin-inline: auto;
        // max-width: 1440px;
      }

      @include bp(xl) {
        margin-inline: auto;
        max-width: 1440px;
      }
    }

    .callToAction {
      width: 100%;
      // height: 1045px;
      height: fit-content;
      background: #ffffff;
      border: 1px solid #e5e9f0;
      box-shadow:
        0px 1px 3px rgba(15, 23, 42, 0.06),
        0px 1px 2px rgba(15, 23, 42, 0.04);
      border-radius: 16px;
      position: relative;
      overflow: hidden;

      @include bp(lg) {
        display: flex;
        flex-direction: row;
        height: 469px;
      }

      .top {
        width: 100%;
        height: 412.8px;
        background: #0f172a;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 32px;
        padding: 35px;

        @include bp(lg) {
          width: 42%;
          height: 100%;
          gap: 50px;
        }

        .topText {
          display: flex;
          flex-direction: column;
          gap: 18px;

          @include bp(lg) {
            gap: 25px;
          }

          span {
            font-weight: 600;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.7);
          }

          h3 {
            font-family: var(--font-barlow);
            font-weight: 700;
            font-size: 30px;
            color: #ffffff;
          }

          p {
            font-weight: 400;
            font-size: 14px;
            color: rgba(255, 255, 255, 0.75);
          }
        }

        .topDesc {
          display: flex;
          flex-direction: column;
          gap: 18px;
        }

        .topRow {
          display: flex;
          flex-direction: row;
          gap: 12px;
          transition: 0.3s;
          cursor: pointer;
          width: fit-content;
          text-decoration: none;

          .iconBox {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            display: flex;
            justify-content: center;
            align-items: center;

            path {
              transition: 0.3s;
            }
          }

          .iconText {
            display: flex;
            flex-direction: column;
            height: 40px;
            justify-content: space-between;

            span {
              font-weight: 400;
              font-size: 11.2px;
              color: rgba(255, 255, 255, 0.6);
            }

            p {
              font-family: var(--font-barlow);
              font-weight: 600;
              font-size: 18px;
              color: #ffffff;
              text-decoration: none;
              transition: 0.3s;
            }
          }

          &:hover {
            p {
              color: #0393cf !important;
            }

            path {
              stroke: #0393cf !important;
            }
          }
        }

        .topBlob2 {
          position: absolute;
          width: 192px;
          height: 192px;
          left: -80px;
          top: -80px;
          background: rgba(2, 132, 199, 0.2);
          -webkit-transform: translateZ(0);
          transform: translateZ(0);
          filter: blur(32px);
          border-radius: 50px;
        }

        .topBlob1 {
          position: absolute;
          width: 160px;
          height: 160px;
          right: 0;
          bottom: 0;
          background: rgba(234, 88, 12, 0.2);
          // filter: blur(32px);
          -webkit-transform: translateZ(0);
          transform: translateZ(0);
          filter: blur(32px);
          border-radius: 50px;
        }
      }

      .form {
        display: flex;
        flex-direction: column;
        gap: 25px;
        padding: 33px;

        @include bp(lg) {
          padding: 50px;
          // width: 100%;
          flex: 1 auto;
        }

        .formGrid {
          display: flex;
          flex-direction: column;
          gap: 25px;

          @include bp(lg) {
            display: grid;
            grid-template-columns: 1fr 1fr;
          }
        }

        .formRow {
          display: flex;
          flex-direction: column;
          gap: 8px;

          @include bp(lg) {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
          }

          span {
            font-weight: 400;
            font-size: 12px;
            color: #4b5563;
          }
        }

        .formCol {
          display: flex;
          flex-direction: column;
          gap: 8px;

          label {
            font-weight: 600;
            font-size: 12px;
            color: #0f172a;
          }

          input {
            width: 100%;
            height: 37.6px;
            background: #ffffff;
            border: 0.8px solid #e5e9f0;
            border-radius: 6px;
            font-weight: 400;
            font-size: 16px;
            color: black;
            padding: 0 12px;

            &::placeholder {
              color: rgba(33, 37, 41, 0.75);
            }
          }

          input:focus {
            outline: none;
          }

          label.required::after {
            content: ' *';
            color: #ea580c;
            font-weight: bold;
          }

          textarea {
            width: 100%;
            height: 110px;
            background: #ffffff;
            border: 0.8px solid #e5e9f0;
            border-radius: 6px;
            font-weight: 400;
            font-size: 16px;
            color: black;
            padding: 10px 12px;
            resize: none;

            &::placeholder {
              color: rgba(33, 37, 41, 0.75);
            }
          }

          span {
            font-weight: 400;
            font-size: 12px;
            color: #4b5563;
          }
        }

        .botcheck {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
          white-space: nowrap;
        }
      }
    }
  </style>
</div>
