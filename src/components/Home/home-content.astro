---
import Phone from '@assets/svgs/phone.svg'
import Check from '@assets/svgs/check.svg'
import ServiceGrid from '../service-grid.astro'
import SectorGrid from '../sector-grid.astro'
import Featured from './featured.astro'
import Reviews from './reviews.astro'
import CallToAction from '../call-to-action.astro'
import Reveal from '../reveal.astro'
import InfoGrid from '../info-grid.astro'

import '../Reused.scss'

const points = [
  'Family-owned since 1990 with strong values at the heart of the business',
  'Full in-house capability — CNC punching, laser, bending, fabrication & powder coating',
  'Full in-house capability — CNC punching, laser, bending, fabrication & powder coating',
  'Full in-house capability — CNC punching, laser, bending, fabrication & powder coating',
];
---

<!-- TEXT: SORT THIS -->
<section class="section home">
  <div class="blueBlob"></div>
  <div class="orangeBlob"></div>
  <Reveal>
    <div class="topGap">
      <div class="intro">
        <div class="established">
          <svg width="6" height="6" viewBox="0 0 6 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="5.8625" height="6" rx="2.93125" fill="#0393CF"></rect>
          </svg>
          <p>Established 1990 · Stoke-on-Trent</p>
        </div>
        <div class="topTextGap">
          <h1>
            Sheet metal fabrication &amp; engineering in {' '}
            <span class="blueColour">Stoke-on-Trent</span>.
          </h1>
          <p class="homeDesc">
            Bowson Engineering is a family-owned business with strong values at the heart of everything we do. Our core capability is the manufacture of bespoke sheet metal products — supplied individually or combined with CNC punching, laser cutting, bending, fabrication and powder coating. We engage with customer design from the outset, using SolidWorks 3D modelling to optimise work processes,
            reduce cost and deliver reliable quality with fast turnaround — from custom one-offs to larger batch runs.
          </p>
        </div>
        <div class="buttonRow">
          <a href="/contact-us" class="orangeButton"><p>Request a Quote</p></a>
          <a href="tel:+441782749000" class="centerFlex phoneGap">
            <Phone />
            <p>01782 749000</p>
          </a>
        </div>
      </div>
      <div class="imgHouse">
        <div class="img">Placeholder</div>
        <div class="capabilities">
          <span>In-house capability</span>
          <p>Design → Punch → Bend → Weld → Coat</p>
        </div>
      </div>
    </div>
  </Reveal>
  <InfoGrid borderAndBg={false} />
  <div class="mainBlock">
    <Reveal>
      <div class="mainBlockText">
        <p class="blueTitle">What we do</p>
        <div class="textBlock">
          <h2 class="h2Title">In-house services from design to finished product.</h2>
          <h3>We subcontract our services individually or combined — engaging with customer design to find the most cost-effective way to manufacture.</h3>
        </div>
      </div>
    </Reveal>
    <ServiceGrid />
  </div>
  <div class="darkerBg">
    <div class="mainBlock">
      <Reveal>
        <div class="mainBlockText">
          <p class="blueTitle">Industries we serve</p>
          <div class="textBlock">
            <h2 class="h2Title">Trusted across UK industry.</h2>
            <h3>From manufacturers to construction sites, we deliver durable, well-engineered sheet metal products to demanding sectors.</h3>
          </div>
        </div>
      </Reveal>
      <SectorGrid />
    </div>
  </div>
  <div class="topGap">
    <Reveal from="left">
      <div class="aboutImage">
        <div class="img">Placeholder</div>
        <div class="yearsIn">
          <h4>35+</h4>
          <p>Years in business</p>
        </div>
      </div>
    </Reveal>
    <Reveal from="right">
      <div class="mainBlockNoPadding">
        <p class="blueTitle">About Bowson Engineering</p>
        <div class="textBlock">
          <h2 class="h2Title h2TitleFullWidth">A Stoke-on-Trent family business built on quality, reliability and engineering know-how.</h2>
          <h3 class="h2TitleFullWidth">
            From our Fenton facility we manufacture bespoke sheet metal products for clients across the UK. We engage with customer design and look at cost-effective ways to manufacture — optimising work processes to create savings and shorten lead times. Whether you need a single custom item or a larger batch run, our team takes the project from concept through to finished product.
          </h3>
        </div>
        <ul class="aboutList">
          {
            points.map((point) => (
              <li>
                <Check />
                <p>{point}</p>
              </li>
            ))
          }
        </ul>
        <a href="/about-us" class="orangeButton"><p>About us</p></a>
      </div>
    </Reveal>
  </div>
  <div class="mainBlock">
    <Reveal>
      <div class="mainBlockText">
        <p class="blueTitle">Featured work</p>
        <div class="textBlock">
          <h2 class="h2Title">Bespoke products, engineered in Stoke-On-Trent.</h2>
          <h3>A small selection of past projects — from deer towers and pallet gates to machine guards, kennels and bespoke stillages.</h3>
        </div>
      </div>
    </Reveal>
    <Featured />
  </div>
  <div class="darkerBg">
    <div class="mainBlock">
      <p class="blueTitle blueTitleCentre">What clients say</p>
      <div class="textBlock blueTitleCentre">
        <h2 class="h2Title h2TitleFullWidth blueTitleCentre">Engineered relationships, built to last.</h2>
        <h3 class="h2TitleFullWidth">Real client testimonials will be added during launch — placeholders shown below. TODO</h3>
      </div>
      <Reviews />
      <p class="designedText">Designed & manufactured with industry-standard software</p>
      <!-- TODO: get the images -->
      <div class="softwareGrid">
        <div class="softwareItem"></div>
        <div class="softwareItem"></div>
        <div class="softwareItem"></div>
        <div class="softwareItem"></div>
      </div>
    </div>
  </div>
  <CallToAction />
</section>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .home {
    position: relative;
    width: 100%;

    h1 {
      font-family: var(--font-barlow);
      font-style: normal;
      font-weight: 700;
      font-size: fluid(2.25rem, 3.75rem);
      color: #0f172a;

      // @include bp(xl) {
      //   width: 85%;
      // }

      span {
        width: 100%;
      }

      .blueColour {
        color: #0393cf;
      }
    }

    .homeDesc {
      font-style: normal;
      font-weight: 400;
      font-size: 16px;
      font-size: fluid(1rem, 1.2rem);
      color: #4b5563;

      // @include bp(xl) {
      //   width: 85%;
      // }
    }
  }

  .topTextGap {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: relative;
    width: 100%;
  }

  .topGap {
    display: flex;
    flex-direction: column;
    gap: 36px;
    position: relative;
    width: 100%;
    padding: 0 26px;
    margin-bottom: 35px;

    @include bp(lg) {
      display: grid;
      grid-template-columns: 1fr 1.33fr; // check Figma's actual column ratio, may not be 50/50
      align-items: center;
      padding: 0 100px;
      // margin-bottom: 0;
      // margin-inline: auto;
      // max-width: 1440px;
    }

    @include bp(xl) {
      // padding: 0;
      margin-inline: auto;
      max-width: 1440px;
    }
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .established {
    width: fit-content;
    height: 45.6px;
    background: #f8f9fa;
    border: 0.8px solid #e5e9f0;
    border-radius: 999px;
    display: flex;
    align-items: center;
    padding: 0 13px;
    gap: 13px;
    position: relative;

    @include bp(lg) {
      height: 27px;
    }

    p {
      font-style: bold;
      font-weight: 600;
      font-size: 12px;
      color: #0393cf;
    }
  }

  .blueBlob {
    position: absolute;
    width: 300px;
    height: 420px;
    right: 0;
    top: -128px;
    background: #0284c70d;
    filter: blur(50px);
    border-radius: 50px;
  }

  .orangeBlob {
    position: absolute;
    width: 360px;
    height: 360px;
    left: -128px;
    top: 160px;
    background: rgba(234, 88, 12, 0.05);
    filter: blur(32px);
    border-radius: 50px;
  }

  .imgHouse {
    border-radius: 16px;
    width: 100%;
    aspect-ratio: 742 / 418;
    background: linear-gradient(135deg, #dceefb 0%, #eef6fb 15%, #ffffff 45%, #fdf3ea 75%, #fbe4cd 100%);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;

    .capabilities {
      display: none;
      position: absolute;
      width: fit-content;
      height: 96px;
      background: #ffffff;
      border: 0.8px solid #e5e9f0;
      box-shadow:
        0px 6px 12px -6px rgba(15, 23, 42, 0.08),
        0px 12px 30px -10px rgba(2, 132, 199, 0.25);
      border-radius: 12px;
      bottom: -25px;
      left: 70px;
      flex-direction: column;
      justify-content: center;
      padding: 0 17px;
      gap: 5px;

      @include bp(lg) {
        display: flex;
      }

      span {
        font-weight: 600;
        font-size: 12px;
        color: #4b5563;
      }

      p {
        font-family: var(--font-barlow);
        font-weight: 700;
        font-size: 20px;
        color: #0f172a;
      }
    }

    .img {
      width: 93%;
      height: 93%;
      border: 1px solid #e5e9f0;
      box-shadow:
        0px 6px 12px -6px rgba(15, 23, 42, 0.08),
        0px 12px 30px -10px rgba(2, 132, 199, 0.25);
      border-radius: 12px;
      object-fit: cover;
    }
  }

  .mainBlockNoPadding {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 35px 0px;

    @include bp(lg) {
      padding: 50px 0px;
    }

    h3 {
      font-weight: 400;
      font-size: 18px;
      color: #4b5563;

      @include bp(lg) {
        width: 60%;
      }
    }

    a {
      text-decoration: none;
    }
  }

  .aboutList {
    padding: 0 20px;
    list-style: none;
    margin: 0;
    padding: 0;

    li {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 0.5rem;

      svg {
        flex-shrink: 0;
        margin-top: 0.15rem; // nudge to align with text baseline
      }

      p {
        font-weight: 400;
        font-size: 14px;
        color: #0f172a;
      }
    }
  }

  .aboutImage {
    display: none;
    border-radius: 16px;
    width: 90%;
    aspect-ratio: 478 / 360;
    background: linear-gradient(to bottom right, #fde9de 0%, #fef3ee 25%, #ffffff 50%, #eef7fb 75%, #dceef7 100%);
    justify-content: center;
    align-items: center;
    position: relative;

    @include bp(lg) {
      display: flex;
    }

    .yearsIn {
      position: absolute;
      width: fit-content;
      height: 82.8px;

      background: #0393cf;
      box-shadow:
        0px 6px 12px -6px rgba(15, 23, 42, 0.08),
        0px 12px 30px -10px rgba(2, 132, 199, 0.25);
      border-radius: 12px;
      border-radius: 12px;
      bottom: -15px;
      right: -10px;
      flex-direction: column;
      justify-content: center;
      // align-items: center;
      padding: 0 20px;

      @include bp(lg) {
        display: flex;
      }

      h4 {
        font-family: var(--font-barlow);
        font-weight: 700;
        font-size: 30px;
        color: #ffffff;
      }

      p {
        font-weight: 600;
        font-size: 11.2px;
        color: #ffffff;
      }
    }

    .img {
      width: 93%;
      height: 93%;
      border: 1px solid #e5e9f0;
      box-shadow:
        0px 6px 12px -6px rgba(15, 23, 42, 0.08),
        0px 12px 30px -10px rgba(2, 132, 199, 0.25);
      border-radius: 12px;
      object-fit: cover;
    }
  }

  .designedText {
    font-weight: 600;
    font-size: 12px;
    text-align: center;
    color: #4b5563;
    width: 80%;
    margin: 0 auto;

    @include bp(lg) {
      margin-top: 30px;
    }
  }

  .softwareGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;

    @include bp(lg) {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }

    .softwareItem {
      width: 160px;
      height: 80px;
      background: #ffffff;
      border: 0.8px solid #e5e9f0;
      border-radius: 8px;

      @include bp(lg) {
        width: 100%;
      }
    }
  }
</style>
