---
import Reveal from "../reveal.astro"

const reviews = [
  {},
  {},
  {}
]
---

<div class="reviews">
  {
    reviews.map((review, i) => (
      <Reveal delay={i * 70} from="right">
        <div class={`review ${i === 1 && 'reviewHighlighted'}`}>
          <div class="reviewGap">
            {/* TODO: add to asset */}
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M18.6667 3.5C18.0478 3.5 17.4543 3.74583 17.0167 4.18342C16.5792 4.621 16.3333 5.21449 16.3333 5.83333V12.8333C16.3333 13.4522 16.5792 14.0457 17.0167 14.4832C17.4543 14.9208 18.0478 15.1667 18.6667 15.1667C18.9761 15.1667 19.2728 15.2896 19.4916 15.5084C19.7104 15.7272 19.8333 16.0239 19.8333 16.3333V17.5C19.8333 18.1188 19.5875 18.7123 19.1499 19.1499C18.7123 19.5875 18.1188 19.8333 17.5 19.8333C17.1906 19.8333 16.8938 19.9562 16.675 20.175C16.4562 20.3938 16.3333 20.6906 16.3333 21V23.3333C16.3333 23.6428 16.4562 23.9395 16.675 24.1583C16.8938 24.3771 17.1906 24.5 17.5 24.5C19.3565 24.5 21.137 23.7625 22.4497 22.4497C23.7625 21.137 24.5 19.3565 24.5 17.5V5.83333C24.5 5.21449 24.2542 4.621 23.8166 4.18342C23.379 3.74583 22.7855 3.5 22.1667 3.5H18.6667Z"
                stroke="#0393CF"
                stroke-width="2.33333"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M5.83333 3.5C5.21449 3.5 4.621 3.74583 4.18342 4.18342C3.74583 4.621 3.5 5.21449 3.5 5.83333V12.8333C3.5 13.4522 3.74583 14.0457 4.18342 14.4832C4.621 14.9208 5.21449 15.1667 5.83333 15.1667C6.14275 15.1667 6.4395 15.2896 6.65829 15.5084C6.87708 15.7272 7 16.0239 7 16.3333V17.5C7 18.1188 6.75417 18.7123 6.31658 19.1499C5.879 19.5875 5.28551 19.8333 4.66667 19.8333C4.35725 19.8333 4.0605 19.9562 3.84171 20.175C3.62292 20.3938 3.5 20.6906 3.5 21V23.3333C3.5 23.6428 3.62292 23.9395 3.84171 24.1583C4.0605 24.3771 4.35725 24.5 4.66667 24.5C6.52318 24.5 8.30366 23.7625 9.61641 22.4497C10.9292 21.137 11.6667 19.3565 11.6667 17.5V5.83333C11.6667 5.21449 11.4208 4.621 10.9832 4.18342C10.5457 3.74583 9.95217 3.5 9.33333 3.5H5.83333Z"
                stroke="#0393CF"
                stroke-width="2.33333"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <p>“Bowson have been a trusted partner for our fabrication work for years. Fast, accurate and always willing to engage on design.”</p>
          </div>
          <div class="reviewBottom">
            <p>Operations Manager</p>
            <span>UK Manufacture (todo)</span>
          </div>
        </div>
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .reviews {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;

    @include bp(lg) {
      margin-top: 30px;
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .reviewHighlighted {
    border-color: #0393cf !important;
    box-shadow:
      0px 6px 12px -6px rgba(15, 23, 42, 0.08),
      0px 12px 30px -10px rgba(2, 132, 199, 0.25) !important;
  }

  .review {
    width: 335.2px;
    height: 292.6px;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 12px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    @include bp(lg) {
      width: 100%;
    }

    .reviewGap {
      display: flex;
      flex-direction: column;
      gap: 20px;

      p {
        font-weight: 400;
        font-size: 14px;
        color: #0f172a;
      }
    }

    .reviewBottom {
      p {
        font-family: var(--font-barlow);
        font-weight: 600;
        font-size: 14px;
        color: #0f172a;
      }

      span {
        font-weight: 400;
        font-size: 12px;
        color: #4b5563;
      }
    }
  }
</style>
