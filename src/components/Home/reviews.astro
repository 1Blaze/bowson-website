---
import Reveal from "../reveal.astro"
import SpeechMark from '@assets/svgs/speech-mark.svg'

type ReviewType = {
  description: string;
  title: string;
  name: string
}

const reviews: ReviewType[] = [
  {
    description: 'A brilliant company to deal with. We have used their services for many years and the quality of their work is second to none. Very responsive and always happy to help.',
    title: 'Director',
    name: 'Kilns Client'
  }
]
---

<!-- TEXT: SORT THIS -->
<div class="reviews">
  {
    reviews.map((review, i) => (
      <Reveal delay={270 - i * 70} from="right">
        <div class={`review ${i === 1 && 'reviewHighlighted'}`}>
          <div class="reviewGap">
            <SpeechMark />
            <p>“{review.description}”</p>
          </div>
          <div class="reviewBottom">
            <p>{review.title}</p>
            <span>{review.name}</span>
          </div>
        </div>
      </Reveal>
    ))
  }
</div>

<style lang="scss">
  @use '../../styles/breakpoints' as *;

  .reviews {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;

    @include bp(lg) {
      margin-top: 30px;
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .reviewHighlighted {
    border-color: #0393cf !important;
    box-shadow:
      0px 6px 12px -6px rgba(15, 23, 42, 0.08),
      0px 12px 30px -10px rgba(2, 132, 199, 0.25) !important;
  }

  .review {
    width: 335.2px;
    height: 292.6px;
    background: #ffffff;
    border: 0.8px solid #e5e9f0;
    box-shadow:
      0px 1px 3px rgba(15, 23, 42, 0.06),
      0px 1px 2px rgba(15, 23, 42, 0.04);
    border-radius: 12px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    @include bp(lg) {
      width: 100%;
    }

    .reviewGap {
      display: flex;
      flex-direction: column;
      gap: 20px;

      p {
        font-weight: 400;
        font-size: 14px;
        color: #0f172a;
      }
    }

    .reviewBottom {
      p {
        font-family: var(--font-barlow);
        font-weight: 600;
        font-size: 14px;
        color: #0f172a;
      }

      span {
        font-weight: 400;
        font-size: 12px;
        color: #4b5563;
      }
    }
  }
</style>
