---
import { Image } from 'astro:assets';
import Punch from '@assets/images/services/punch.webp';
import Powdercoating from '@assets/images/services/oven.webp';
import Forming from '@assets/images/services/forming.webp';
import Welding from '@assets/images/services/weld.webp';
import Laser from '@assets/images/services/laser.webp';
import Modelling from '@assets/images/services/3dmodelling.webp';
import Arrow from '@assets/svgs/arrow-button.svg'
import Reveal from './reveal.astro';


type ServiceType = {
  title: string;
  description: string;
  image: ImageMetadata;
  coverFIt: boolean;
  link: string
};

const services: ServiceType[] = [
  {
    title: 'CNC Punching',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    image: Punch,
    coverFIt: false,
    link: 'cnc-punching'
  },
    {
    title: 'Laser Cutting',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    image: Laser,
    coverFIt: false,
    link: 'cnc-punching'
  },
    {
    title: 'Metal Forming',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    image: Forming,
    coverFIt: false,
    link: 'cnc-punching'
  },
    {
    title: 'Metal Welding',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    image: Welding,
    coverFIt: false,
    link: 'cnc-punching'
  },
      {
    title: 'Powder Coating',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    image: Powdercoating,
    coverFIt: false,
    link: 'cnc-punching'
  },
    {
    title: '3D Cad Design',
    description: 'Precision turret punching for sheet steel, aluminium and stainless components.',
    image: Modelling,
    coverFIt: true,
    link: 'cnc-punching'
  },
];
---

<!-- TEXT: SORT THIS -->
<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="up">
        <a href={`/services/${service.link}`} class="serviceItem">
          <Image class={service.coverFIt ? 'imgCoverFit' : ''} src={service.image} alt={service.title} />
          <div class="serviceTextGap">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="serviceLearnMore">
              <span>Learn more</span>
              <Arrow />
            </div>
          </div>
        </a>
      </Reveal>
    ))
  }
</div>
