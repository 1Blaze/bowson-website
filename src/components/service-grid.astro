---
import { Image } from 'astro:assets';
import Punch from '@assets/images/services/punch.webp';
import Powdercoating from '@assets/images/services/oven.webp';
import Forming from '@assets/images/services/forming.webp';
import Welding from '@assets/images/services/weld.webp';
import Laser from '@assets/images/services/laser.webp';
import Modelling from '@assets/images/services/3dmodelling.webp';
import Arrow from '@assets/svgs/arrow-button.svg'
import Reveal from './reveal.astro';


type ServiceType = {
  title: string;
  description: string;
  image: ImageMetadata;
  coverFit: boolean;
  imageAlt: string;
  link: string
};

const services: ServiceType[] = [
  {
    title: 'CNC Punching',
    description: 'CNC turret punching of steel, aluminium and stainless sheet to your drawings, including perforated panels, louvres and upforms.',
    image: Punch,
    imageAlt: 'CNC turret punch machine punching a pattern of rectangular holes into sheet metal',
    coverFit: false,
    link: 'cnc-punching',
  },
  {
    title: 'Laser Cutting',
    description: 'Laser-cut steel, stainless and aluminium parts, sourced through our cutting partners and managed as part of your order.',
    image: Laser,
    imageAlt: 'Flat laser-cut steel sheet with accurately cut profiles and openings',
    coverFit: false,
    link: 'laser-cutting',
  },
  {
    title: 'Metal Bending & Forming',
    description: 'CNC press brake bending of sheet metal parts, from simple folds to complex profiles, with rolling available, in one-offs or repeat batches.',
    image: Forming,
    imageAlt: 'Formed sheet metal enclosures with punched slots in sides alongside a press brake machine',
    coverFit: false,
    link: 'bending-metal-forming',
  },
  {
    title: 'Welding & Fabrication',
    description: 'MIG and TIG welding, fabrication and assembly of steel and stainless parts, from single items to complete bespoke products.',
    image: Welding,
    imageAlt: 'MIG welding a steel fabrication with a bright welding arc and sparks',
    coverFit: false,
    link: 'welding-fabrication',
  },
  {
    title: 'Powder Coating',
    description: 'In-house powder coating for sheet metal parts and fabricated products, giving a durable finish in a range of colours.',
    image: Powdercoating,
    imageAlt: 'Purple powder-coated steel discs and brackets hanging inside a powder coating booth',
    coverFit: false,
    link: 'powder-coating',
  },
  {
    title: '3D CAD Design',
    description: 'SolidWorks 3D CAD modelling and technical drawings to develop bespoke products and prepare parts for manufacture.',
    image: Modelling,
    imageAlt: 'SolidWorks 3D CAD model of an industrial steel oven frame with a pull-out tray',
    coverFit: true,
    link: '3d-cad-design',
  },
];
---

<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="up">
        <a href={`/services/${service.link}`} class="serviceItem">
          <Image class={service.coverFit ? 'imgCoverFit' : ''} src={service.image} alt={service.imageAlt} />
          <div class="serviceTextGap">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="serviceLearnMore">
              <span>Learn more</span>
              <Arrow />
            </div>
          </div>
        </a>
      </Reveal>
    ))
  }
</div>
