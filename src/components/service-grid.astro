---
import { Image } from 'astro:assets';
import Punch from '@assets/images/services/punch.webp';
import Powdercoating from '@assets/images/services/oven.webp';
import Forming from '@assets/images/services/forming.webp';
import Welding from '@assets/images/services/weld.webp';
import Laser from '@assets/images/services/laser.webp';
import Modelling from '@assets/images/services/3dmodelling.webp';
import Arrow from '@assets/svgs/arrow-button.svg'
import Reveal from './reveal.astro';


type ServiceType = {
  title: string;
  description: string;
  image: ImageMetadata;
  coverFit: boolean;
  imageAlt: string;
  link: string
};

// TEXT: SORT THIS
const services: ServiceType[] = [
  {
    title: 'CNC Punching',
    description: 'CNC turret punching of sheet steel, aluminium and stainless components.',
    image: Punch,
    imageAlt: 'Turret punch tooling punching a pattern of rectangular holes in a steel sheet',
    coverFit: false,
    link: 'cnc-punching',
  },
  {
    title: 'Laser Cutting',
    description: 'Laser-cut blanks supplied through our cutting partner and managed alongside your job.',
    image: Laser,
    imageAlt: 'Flat laser-cut steel sheet with a pattern of cut-outs',
    coverFit: false,
    link: 'laser-cutting',
  },
  {
    title: 'Metal Forming',
    description: 'Press brake bending of sheet metal parts, from single pieces to repeat batches.',
    image: Forming,
    imageAlt: 'Stack of formed steel enclosures with louvred sides in front of a press brake',
    coverFit: false,
    link: 'bending-metal-forming',
  },
  {
    title: 'Metal Welding',
    description: 'MIG and TIG welding for fabricated steel and stainless assemblies.',
    image: Welding,
    imageAlt: 'MIG welding a steel plate with a bright blue arc and sparks',
    coverFit: false,
    link: 'welding-fabrication',
  },
  {
    title: 'Powder Coating',
    description: 'In-house powder coating for steel fabrications and sheet metal parts, in a choice of colours.',
    image: Powdercoating,
    imageAlt: 'Purple powder coated steel discs and brackets hanging in a coating booth',
    coverFit: false,
    link: 'powder-coating',
  },
  {
    title: '3D CAD Design',
    description: 'SolidWorks 3D modelling and drawings for fabricated products.',
    image: Modelling,
    imageAlt: '3D CAD model of a large steel oven frame with a pull-out tray',
    coverFit: true,
    link: '3d-cad-design',
  },
];
---

<!-- TEXT: SORT THIS -->
<div class="servicesDisplay">
  {
    services.map((service, i) => (
      <Reveal delay={i * 70} from="up">
        <a href={`/services/${service.link}`} class="serviceItem">
          <Image class={service.coverFit ? 'imgCoverFit' : ''} src={service.image} alt={service.imageAlt} />
          <div class="serviceTextGap">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="serviceLearnMore">
              <span>Learn more</span>
              <Arrow />
            </div>
          </div>
        </a>
      </Reveal>
    ))
  }
</div>
