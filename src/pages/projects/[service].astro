---
import ProjectsTemplate from '~/src/components/Projects/Template/projects-template.astro';
import Layout from '../../layouts/Layout.astro';
import { GetProject } from '~/src/data/projects';

export function getStaticPaths() {
  return [
    { params: { service: "deer-towers" }},
    { params: { service: "dog-kennels" }},
    { params: { service: "truck-kilns" }},
    { params: { service: "fk-heavy-duty-kilns" }},
    { params: { service: "work-benches" }},
    { params: { service: "roll-stand" }},
    { params: { service: "pallet-gates" }},
    { params: { service: "stillages" }},
    { params: { service: "machine-guarding" }},
    { params: { service: "smoking-shelters" }},
    { params: { service: "seatbeds" }},
  ];
}

const { service } = Astro.params;
const data = GetProject(service)
---

<Layout title={data.seoTitle} description={data.seoDesc}>
  <ProjectsTemplate id={service} />
</Layout>
