---
import Layout from '../../layouts/Layout.astro';
import SectorsTemplate from '~/src/components/Sectors/Template/sectors-template.astro';
import { GetSector } from '~/src/data/sectors';

export function getStaticPaths() {
  return [
    { params: { service: "agriculture-estate" }},
    { params: { service: "ceramics-pottery" }},
    { params: { service: "manufacturing-production" }},
    { params: { service: "material-handling-storage" }},
    { params: { service: "safety-access" }},
    { params: { service: "vehicle-campervan-conversions" }},
  ];
}

const { service } = Astro.params;
const data = GetSector(service)
---

<Layout title={data.seoTitle} description={data.seoDesc}>
  <SectorsTemplate id={service} />
</Layout>
